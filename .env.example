# ---- 数据源 ----
# 本地开发用 SQLite；云端用 Neon 的 Postgres
# DATABASE_URL=postgresql+user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=sqlite:///./data/news.db
DATA_DIR=./data

# ---- 对象存储（Cloudflare R2）----
# 留空则音频与 JSON 存本地磁盘；配全四项自动切到 R2。
# 注册步骤见 docs/注册指南.md
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_BASE=https://<bucket>.<accountid>.r2.dev

# ---- 静态 JSON（App 可不经服务器直读 CDN）----
EXPORT_JSON=true
# App 端访问 JSON 的基地址，一般与 R2_PUBLIC_BASE 相同
PUBLIC_BASE_URL=

# ---- LLM（可全部留空，走离线降级）----
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# ---- 配图（多级降级：unsplash → pexels → wikimedia → openverse）----
# 缺 key 的图源自动跳过；全部失败则回退渐变占位块，不会缺图。
IMAGE_FETCH_ENABLED=true
IMAGE_PROVIDERS=unsplash,pexels,wikimedia,openverse
# Unsplash 首选：https://unsplash.com/developers 申请 Access Key
# 走 API 必须：hotlink（不转存自己的 CDN）+ 图上署名 + 回链带 utm
UNSPLASH_ACCESS_KEY=
UNSPLASH_APP_NAME=daily-english-news
# Pexels 备选：https://www.pexels.com/api/
PEXELS_API_KEY=
# 禁止用新闻原图兜底（非商用授权，且热链易失效）
IMAGE_ALLOW_SOURCE_FALLBACK=false

# ---- TTS（edge-tts 免费，无需 key）----
TTS_ENABLED=true
TTS_VOICE_EN=en-US-AriaNeural
TTS_VOICE_JA=ja-JP-NanamiNeural

# ---- 抓取 ----
TOPICS=tech,business,science,health,sports,culture,world
ARTICLES_PER_TOPIC=1
# 选题去重回看天数：最近这些天用过的标题不再复用（挡「隔天换个说法再写一遍」）
DEDUP_LOOKBACK_DAYS=60