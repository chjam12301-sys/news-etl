# ---- 数据源 ----
# 本地开发用 SQLite；云端用 Neon 的 Postgres
# DATABASE_URL=postgresql+user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=sqlite:///./data/news.db
DATA_DIR=./data

# ---- 对象存储（Cloudflare R2）----
# 留空则音频与 JSON 存本地磁盘；配全四项自动切到 R2。
# 注册步骤见 docs/注册指南.md
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_BASE=https://<bucket>.<accountid>.r2.dev

# ---- 静态 JSON（App 可不经服务器直读 CDN）----
EXPORT_JSON=true
# App 端访问 JSON 的基地址，一般与 R2_PUBLIC_BASE 相同
PUBLIC_BASE_URL=

# ---- LLM（可全部留空，走离线降级）----
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# ---- TTS（edge-tts 免费，无需 key）----
TTS_ENABLED=true
TTS_VOICE_EN=en-US-AriaNeural
TTS_VOICE_JA=ja-JP-NanamiNeural

# ---- 抓取 ----
TOPICS=tech,business,science,health,sports,culture,world
ARTICLES_PER_TOPIC=1