": 239, "reading_minutes": 1.2, "lead": "Violence spread across France on Saturday as hundreds of thousands of people protested against the cost of living and poor conditions in schools. The government said more than 1,200 people were arrested.", "lead_zh": "周六，数十万法国人因生活成本上涨和学校条件恶劣走上街头抗议，暴力事件在全国蔓延。政府表示，已有超过1200人被捕。", "preview": "An estimated 550,000 people took to the streets on Saturday, according to the French government. In Paris, the main march was mostly peacefu", "preview_zh": "据法国政府估计，周六约有55万人走上街头。在巴黎，下午的主要游行基本和平，但傍晚与防暴警察发生了冲突。警察对人群使用了催泪瓦斯和高压水枪，有人看到防暴警察冲撞人群并用警棍打人。", "has_audio": true, "audio": {"id": 682, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/70/en_b2.mp3", "duration": 91.0, "size_bytes": 546912, "engine": "kokoro", "voice": "af_heart", "word_count": 279, "has_timeline": true, "alternates": [{"voice": "af_bella", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/70/en_b2_af_bella.mp3", "duration": 92.75, "size_bytes": 557424, "engine": "kokoro", "word_count": 279, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/70/en_b2_af_bella.json"}, {"voice": "am_michael", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/70/en_b2_am_michael.mp3", "duration": 98.975, "size_bytes": 594864, "engine": "kokoro", "word_count": 279, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/70/en_b2_am_michael.json"}, {"voice": "bf_emma", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/70/en_b2_bf_emma.mp3", "duration": 85.075, "size_bytes": 511344, "engine": "kokoro", "word_count": 279, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/70/en_b2_bf_emma.json"}, {"voice": "bm_george", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/70/en_b2_bm_george.mp3", "duration": 92.3, "size_bytes": 554688, "engine": "kokoro", "word_count": 279, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/70/en_b2_bm_george.json"}]}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@7f28595/content/data/versions/694.json"}], "en_c1": [{"content_hash": "e1f680dd8e6458ae", "version_id": 695, "article_id": 70, "level_code": "en_c1", "lang": "en", "level": 5, "level_label": "C1 高级", "title": "France arrests 1,200 as protests turn violent", "title_zh": "法国抗议演变成暴力冲突，1200多人被抓", "has_translation": true, "topic": "world", "source": "bbc_world", "source_url": "https://www.bbc.co.uk/news/articles/c6d937wedj7jo?at_medium=RSS&at_campaign=rss", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1485504750689-aa2121ffe6c6?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8M3x8dmlvbGVudCUyMGNsYXNoZXMlMjBsb290aW5nfGVufDB8MHx8fDE3OTIyNzkxMjd8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Pawel Janiak on Unsplash", "author": "Pawel Janiak", "credit_url": "https://unsplash.com/@pawelj?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/fire-burning-on-the-road-with-high-rise-buildings-during-daytime-photography-49LBMXrY5BE?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(36, 42%, 62%)", "to": "hsl(74, 46%, 48%)", "label": "WORLD", "seed": "f2043e6acb50"}}, "published_date": "2026-10-18", "word_count": 289, "reading_minutes": 1.4, "lead": "Violence erupted across France on Saturday as hundreds of thousands marched against hardship in schools and the rising cost of living. Over 1,200 people were arrested, and buildings from Paris to Limoges were set alight.", "lead_zh": "周六，法国各地爆发暴力冲突，数十万人走上街头，抗议学校条件艰苦和生活成本上涨。超过1200人被捕，从巴黎到利摩日多地的建筑被纵火焚烧。", "preview": "The interior ministry put the turnout at an estimated 550,000 and described the day as an \"escalation in violence\", with riot police in Pari", "preview_zh": "内政部估计参与人数约为55万，并将当天定性为\"暴力升级\"，巴黎防暴警察直到傍晚仍在向人群发射催泪瓦斯并动用高压水枪。首都及多地建筑遭纵火，利摩日尤为严重，市政厅大火导致屋顶部分坍塌。多座城市还报告了抢劫以及针对市政厅和商铺的大规模破坏行为。", "has_audio": true, "audio": {"id": 683, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/70/en_c1.mp3", "duration": 114.7, "size_bytes": 689184, "engine": "kokoro", "voice": "af_heart", "word_count": 352, "has_timeline": true, "alternates": [{"voice": "af_bella", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/70/en_c1_af_bella.mp3", "duration": 118.15, "size_bytes": 709920, "engine": "kokoro", "word_count": 352, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/70/en_c1_af_bella.json"}, {"voice": "am_michael", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/70/en_c1_am_michael.mp3", "duration": 125.8, "size_bytes": 755712, "engine": "kokoro", "word_count": 352, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/70/en_c1_am_michael.json"}, {"voice": "bf_emma", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/70/en_c1_bf_emma.mp3", "duration": 108.5, "size_bytes": 651888, "engine": "kokoro", "word_count": 352, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/70/en_c1_bf_emma.json"}, {"voice": "bm_george", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/70/en_c1_bm_george.mp3", "duration": 116.6, "size_bytes": 700560, "engine": "kokoro", "word_count": 352, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/70/en_c1_bm_george.json"}]}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@7f28595/content/data/versions/695.json"}]}, "ja": {"ja_n5": [{"content_hash": "6649df5fb5e04e68", "version_id": 696, "article_id": 70, "level_code": "ja_n5", "lang": "ja", "level": 1, "level_label": "N5 初級", "title": "フランスでデモ、1000人以上がつかまる", "title_zh": "法国抗议活动超千人被捕", "has_translation": true, "topic": "world", "source": "bbc_world", "source_url": "https://www.bbc.co.uk/news/articles/c6d937wedj7jo?at_medium=RSS&at_campaign=rss", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1485504750689-aa2121ffe6c6?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8M3x8dmlvbGVudCUyMGNsYXNoZXMlMjBsb290aW5nfGVufDB8MHx8fDE3OTIyNzkxMjd8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Pawel Janiak on Unsplash", "author": "Pawel Janiak", "credit_url": "https://unsplash.com/@pawelj?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/fire-burning-on-the-road-with-high-rise-buildings-during-daytime-photography-49LBMXrY5BE?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(36, 42%, 62%)", "to": "hsl(74, 46%, 48%)", "label": "WORLD", "seed": "f2043e6acb50"}}, "published_date": "2026-10-18", "word_count": 100, "reading_minutes": 0.3, "lead": "フランスで土曜日、デモがありました。デモのあと、 violence がおきました。1000人以上が警察につかまりました。", "lead_zh": "周六法国发生了示威。示威之后出现了暴力。超过1000人被警察逮捕。", "preview": "フランスの多くの町で、人がデモをしました。学校と生活のお金が高いことへの不満です。約55万人が道に出ました。", "preview_zh": "法国很多城市有人示威。他们不满学校和生活费太贵。约55万人走上街头。", "has_audio": true, "audio": {"id": 684, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/70/ja_n5.mp3", "duration": 19.6, "size_bytes": 121680, "engine": "kokoro", "voice": "jf_alpha", "word_count": 75, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@7f28595/content/data/versions/696.json"}], "ja_n4": [{"content_hash": "b8e50c97a25d1f22", "version_id": 697, "article_id": 70, "level_code": "ja_n4", "lang": "ja", "level": 2, "level_label": "N4 初級", "title": "フランスで抗議デモが暴動に、1,200人逮捕", "title_zh": "法国抗议演变成骚乱，1200人被捕", "has_translation": true, "topic": "world", "source": "bbc_world", "source_url": "https://www.bbc.co.uk/news/articles/c6d937wedj7jo?at_medium=RSS&at_campaign=rss", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1485504750689-aa2121ffe6c6?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8M3x8dmlvbGVudCUyMGNsYXNoZXMlMjBsb290aW5nfGVufDB8MHx8fDE3OTIyNzkxMjd8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Pawel Janiak on Unsplash", "author": "Pawel Janiak", "credit_url": "https://unsplash.com/@pawelj?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/fire-burning-on-the-road-with-high-rise-buildings-during-daytime-photography-49LBMXrY5BE?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(36, 42%, 62%)", "to": "hsl(74, 46%, 48%)", "label": "WORLD", "seed": "f2043e6acb50"}}, "published_date": "2026-10-18", "word_count": 167, "reading_minutes": 0.5, "lead": "10月17日、フランスの多くの町で抗議デモが暴動になりました。警察は1,200人以上を逮捕しました。", "lead_zh": "10月17日，法国许多城市的抗议活动演变成骚乱。警方逮捕了1200多人。", "preview": "土曜日、フランスでは生活の苦しさと学校の問題に反対するデモがありました。約55万人が道に出て、政府は「暴力がひどくなった」と言いました。", "preview_zh": "周六，法国爆发了反对生活艰难和学校问题的抗议活动。约55万人走上街头，政府称“暴力加剧了”。", "has_audio": true, "audio": {"id": 685, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/70/ja_n4.mp3", "duration": 31.05, "size_bytes": 185760, "engine": "kokoro", "voice": "jf_alpha", "word_count": 119, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@7f28595/content/data/versions/697.json"}], "ja_n3": [{"content_hash": "87664b9364f97e34", "version_id": 698, "article_id": 70, "level_code": "ja_n3", "lang": "ja", "level": 3, "level_label": "N3 中級", "title": "フランスで抗議デモが暴動に、1,200人逮捕・市庁舎も焼ける", "title_zh": "法国抗议演变成暴乱，1200人被捕，市政厅也被烧", "has_translation": true, "topic": "world", "source": "bbc_world", "source_url": "https://www.bbc.co.uk/news/articles/c6d937wedj7jo?at_medium=RSS&at_campaign=rss", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1485504750689-aa2121ffe6c6?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8M3x8dmlvbGVudCUyMGNsYXNoZXMlMjBsb290aW5nfGVufDB8MHx8fDE3OTIyNzkxMjd8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Pawel Janiak on Unsplash", "author": "Pawel Janiak", "credit_url": "https://unsplash.com/@pawelj?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/fire-burning-on-the-road-with-high-rise-buildings-during-daytime-photography-49LBMXrY5BE?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(36, 42%, 62%)", "to": "hsl(74, 46%, 48%)", "label": "WORLD", "seed": "f2043e6acb50"}}, "published_date": "2026-10-18", "word_count": 204, "reading_minutes": 0.6, "lead": "フランスで10月17日、生活の苦しさなどに抗議するデモが各地で行われ、一部が暴動になりました。警察は少なくとも1,200人を逮捕し、建物が焼ける被害も出ています。", "lead_zh": "10月17日，法国各地爆发了抗议生活艰难等的示威活动，部分演变成暴乱。警方至少逮捕了1200人，还有建筑被烧毁。", "preview": "土曜日のデモには約55万人が参加したと見られます。政府は「暴力のエスカレート」だと非難しました。パリでは夜まで機動隊と激しくぶつかり、催涙ガスや放水が使われました。", "preview_zh": "周六的示威估计有约55万人参加。政府谴责这是“暴力的升级”。在巴黎，人群与防暴警察激烈冲突直到夜里，警方使用了催泪瓦斯和高压水枪。", "has_audio": true, "audio": {"id": 686, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/70/ja_n3.mp3", "duration": 35.65, "size_bytes": 213408, "engine": "kokoro", "voice": "jf_alpha", "word_count": 136, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@7f28595/content/data/versions/698.json"}], "ja_n2": [{"content_hash": "5cd1923b2803c18f", "version_id": 699, "article_id": 70, "level_code": "ja_n2", "lang": "ja", "level": 4, "level_label": "N2 中高級", "title": "フランス各地で暴動、1200人逮捕　学校と生活費への抗議が激化", "title_zh": "法国多地爆发骚乱，1200人被捕，学校和生活费抗议升级", "has_translation": true, "topic": "world", "source": "bbc_world", "source_url": "https://www.bbc.co.uk/news/articles/c6d937wedj7jo?at_medium=RSS&at_campaign=rss", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1485504750689-aa2121ffe6c6?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8M3x8dmlvbGVudCUyMGNsYXNoZXMlMjBsb290aW5nfGVufDB8MHx8fDE3OTIyNzkxMjd8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Pawel Janiak on Unsplash", "author": "Pawel Janiak", "credit_url": "https://unsplash.com/@pawelj?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/fire-burning-on-the-road-with-high-rise-buildings-during-daytime-photography-49LBMXrY5BE?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(36, 42%, 62%)", "to": "hsl(74, 46%, 48%)", "label": "WORLD", "seed": "f2043e6acb50"}}, "published_date": "2026-10-18", "word_count": 269, "reading_minutes": 0.8, "lead": "フランスで18日、学校の劣悪な環境や生活費の高騰に抗議するデモが各地で行われ、暴力的な衝突や略奪が発生した。政府によると少なくとも1200人が逮捕され、警察官150人が負傷した。", "lead_zh": "18日，法国各地举行抗议学校恶劣环境和生活成本上涨的示威，发生暴力冲突和抢劫。据政府称，至少1200人被捕，150名警察受伤。", "preview": "フランス全土で18日、学校の環境悪化や生活費の高騰に反対するデモが行われ、約55万人が街頭に集まった。政府は「暴力の激化」と表現し、少なくとも1200人が逮捕された。パリでは夜まで機動隊と激しく衝突し、催涙ガスや放水が使われた。", "preview_zh": "18日，法国各地举行反对学校环境恶化和生活成本上涨的示威，约55万人走上街头。政府称这是“暴力升级”，至少1200人被捕。在巴黎，示威者与防暴警察冲突持续到夜晚，警方使用了催泪瓦斯和高压水枪。", "has_audio": true, "audio": {"id": 687, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/70/ja_n2.mp3", "duration": 51.575, "size_bytes": 308880, "engine": "kokoro", "voice": "jf_alpha", "word_count": 181, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@7f28595/content/data/versions/699.json"}], "ja_n1": [{"content_hash": "3065ba1e467cdf20", "version_id": 700, "article_id": 70, "level_code": "ja_n1", "lang": "ja", "level": 5, "level_label": "N1 上級", "title": "フランス各地で暴動、1200人超逮捕　市庁舎焼失も", "title_zh": "法国多地爆发骚乱，超1200人被捕，市政厅被烧", "has_translation": true, "topic": "world", "source": "bbc_world", "source_url": "https://www.bbc.co.uk/news/articles/c6d937wedj7jo?at_medium=RSS&at_campaign=rss", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1485504750689-aa2121ffe6c6?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8M3x8dmlvbGVudCUyMGNsYXNoZXMlMjBsb290aW5nfGVufDB8MHx8fDE3OTIyNzkxMjd8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Pawel Janiak on Unsplash", "author": "Pawel Janiak", "credit_url": "https://unsplash.com/@pawelj?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/fire-burning-on-the-road-with-high-rise-buildings-during-daytime-photography-49LBMXrY5BE?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(36, 42%, 62%)", "to": "hsl(74, 46%, 48%)", "label": "WORLD", "seed": "f2043e6acb50"}}, "published_date": "2026-10-18", "word_count": 351, "reading_minutes": 1.1, "lead": "フランス全土で抗議デモが暴動に発展し、1200人以上が逮捕された。首都パリでは治安部隊と衝突が起き、地方都市では市庁舎や観光案内所が焼ける事態となった。", "lead_zh": "法国全国范围内的抗议示威演变为骚乱，超过1200人被捕。首都巴黎发生与治安部队的冲突，外地城市则有市政厅和旅游咨询处被烧。", "preview": "フランス各地で土曜日、学校の困窮と生活費の高騰に抗議するデモが行われ、暴力的な衝突や略奪が発生した。政府は「暴力の激化」と表現し、推定55万人が街頭に繰り出した中で少なくとも1200人が逮捕された。パリでは夜にかけて機動隊との激しい衝突が続き、催涙ガスや放水銃が群衆に向けて使用さ", "preview_zh": "周六，法国各地爆发抗议学校困境和生活成本上涨的示威，并发生暴力冲突和抢劫。政府称之为“暴力升级”，在约55万人上街的情况下，至少1200人被捕。巴黎的激烈冲突持续到夜间，防暴警察对人群使用了催泪瓦斯和高压水枪。", "has_audio": true, "audio": {"id": 688, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/70/ja_n1.mp3", "duration": 65.65, "size_bytes": 397440, "engine": "kokoro", "voice": "jf_alpha", "word_count": 237, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@7f28595/content/data/versions/700.json"}]}}}