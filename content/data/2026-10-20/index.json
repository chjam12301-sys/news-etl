yY2h8MXx8a3lsaWUlMjBqZW5uZXJ8ZW58MHwwfHx8MTc5MjQ1NjMzNXww&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Joel Muniz on Unsplash", "author": "Joel Muniz", "credit_url": "https://unsplash.com/@jmuniz?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/man-pointing-forward-mXF1hOJ37BI?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(338, 42%, 62%)", "to": "hsl(16, 46%, 48%)", "label": "CULTURE", "seed": "8b222ce941c5"}}, "published_date": "2026-10-20", "word_count": 89, "reading_minutes": 0.3, "lead": "カイリー・ジェンナーさんがファッションショーに出ました。とても高いブラを着けていました。人々はいろいろな意見を言っています。", "lead_zh": "凯莉·詹娜参加了一场时装秀。她戴着一件非常昂贵的胸罩。人们对此议论纷纷。", "preview": "ジェンナーさんは29歳です。テレビで有名になりました。日曜日、下着のブランド「ビクトリアズ・シークレット」のショーに出ました。", "preview_zh": "詹娜今年29岁。她因电视而出名。周日，她参加了内衣品牌“维多利亚的秘密”的秀。", "has_audio": true, "audio": {"id": 704, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/72/ja_n5.mp3", "duration": 17.275, "size_bytes": 106992, "engine": "kokoro", "voice": "jf_alpha", "word_count": 57, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@e17722d/content/data/versions/716.json"}], "ja_n4": [{"content_hash": "cef03d6e2d398769", "version_id": 717, "article_id": 72, "level_code": "ja_n4", "lang": "ja", "level": 2, "level_label": "N4 初級", "title": "カイリー・ジェンナーさん、5000万ドルのブラでランウェイに　意見が分かれる", "title_zh": "凯莉·詹娜穿5000万美元胸罩走秀，网友看法两极", "has_translation": true, "topic": "culture", "source": "bbc_culture", "source_url": "https://www.bbc.co.uk/news/articles/cmx2wqwxvyxlo?at_medium=RSS&at_campaign=rss", "image": {"type": "photo", "url": "https://images.unsplash.com/flagged/photo-1557286249-08f5bc2ef21d?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MXx8a3lsaWUlMjBqZW5uZXJ8ZW58MHwwfHx8MTc5MjQ1NjMzNXww&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Joel Muniz on Unsplash", "author": "Joel Muniz", "credit_url": "https://unsplash.com/@jmuniz?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/man-pointing-forward-mXF1hOJ37BI?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(338, 42%, 62%)", "to": "hsl(16, 46%, 48%)", "label": "CULTURE", "seed": "8b222ce941c5"}}, "published_date": "2026-10-20", "word_count": 166, "reading_minutes": 0.5, "lead": "アメリカのテレビスター、カイリー・ジェンナーさんがランジェリーのショーに出ました。5000万ドルのブラを着けて、大きな話題になりました。", "lead_zh": "美国电视明星凯莉·詹娜登上了内衣秀的舞台。她戴着价值5000万美元的胸罩，引起很大话题。", "preview": "ジェンナーさんは29歳です。日曜日、ビクトリアズ・シークレットのショーにサプライズで出ました。ブラは18金と4410個のダイヤで作られています。", "preview_zh": "詹娜今年29岁。周日，她惊喜亮相维多利亚的秘密大秀。这件胸罩由18K金和4410颗钻石制成。", "has_audio": true, "audio": {"id": 705, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/72/ja_n4.mp3", "duration": 27.9, "size_bytes": 171216, "engine": "kokoro", "voice": "jf_alpha", "word_count": 105, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@e17722d/content/data/versions/717.json"}], "ja_n3": [{"content_hash": "8560a4666cead8fb", "version_id": 718, "article_id": 72, "level_code": "ja_n3", "lang": "ja", "level": 3, "level_label": "N3 中級", "title": "カイリー・ジェンナーさん、5000万ドルのブラで下着ショー初登場　賛否", "title_zh": "凯莉·詹娜穿5000万美元胸罩首秀内衣秀，引发争议", "has_translation": true, "topic": "culture", "source": "bbc_culture", "source_url": "https://www.bbc.co.uk/news/articles/cmx2wqwxvyxlo?at_medium=RSS&at_campaign=rss", "image": {"type": "photo", "url": "https://images.unsplash.com/flagged/photo-1557286249-08f5bc2ef21d?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MXx8a3lsaWUlMjBqZW5uZXJ8ZW58MHwwfHx8MTc5MjQ1NjMzNXww&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Joel Muniz on Unsplash", "author": "Joel Muniz", "credit_url": "https://unsplash.com/@jmuniz?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/man-pointing-forward-mXF1hOJ37BI?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(338, 42%, 62%)", "to": "hsl(16, 46%, 48%)", "label": "CULTURE", "seed": "8b222ce941c5"}}, "published_date": "2026-10-20", "word_count": 201, "reading_minutes": 0.6, "lead": "リアリティ番組で有名なカイリー・ジェンナーさんが、ビクトリアズ・シークレットのファッションショーに初めて出ました。着けたのは5000万ドルの「ファンタジー・ブラ」です。この選び方に、ファンからは賛成と反対の声が出ています。", "lead_zh": "真人秀明星凯莉·詹娜首次登上维多利亚的秘密时装秀，她穿的是价值5000万美元的“梦幻胸罩”。这一选择让粉丝们赞成的有、反对的也有。", "preview": "このブラは18金と4410個のダイヤモンドで作られていて、デザイナーによると、これまでで最も高い価値があります。例年、このブラを着けるのはモデルにとって名誉なことなので、ブランドがなぜカイリーさんを選んだのか、多くの人が不思議に思いました。", "preview_zh": "这顶胸罩由18K金和4410颗钻石制成，设计师称其价值为历届最高。往年能戴上它是模特的荣誉，所以很多人不理解品牌为什么选了凯莉。", "has_audio": true, "audio": {"id": 706, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/72/ja_n3.mp3", "duration": 33.475, "size_bytes": 200736, "engine": "kokoro", "voice": "jf_alpha", "word_count": 132, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@e17722d/content/data/versions/718.json"}], "ja_n2": [{"content_hash": "bae54c5e54fbba19", "version_id": 719, "article_id": 72, "level_code": "ja_n2", "lang": "ja", "level": 4, "level_label": "N2 中高級", "title": "カイリー・ジェンナーさん、5000万ドルのブラでランウェイに　賛否分かれる", "title_zh": "凯莉·詹娜戴着5000万美元的文胸走秀，网友吵翻了", "has_translation": true, "topic": "culture", "source": "bbc_culture", "source_url": "https://www.bbc.co.uk/news/articles/cmx2wqwxvyxlo?at_medium=RSS&at_campaign=rss", "image": {"type": "photo", "url": "https://images.unsplash.com/flagged/photo-1557286249-08f5bc2ef21d?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MXx8a3lsaWUlMjBqZW5uZXJ8ZW58MHwwfHx8MTc5MjQ1NjMzNXww&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Joel Muniz on Unsplash", "author": "Joel Muniz", "credit_url": "https://unsplash.com/@jmuniz?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/man-pointing-forward-mXF1hOJ37BI?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(338, 42%, 62%)", "to": "hsl(16, 46%, 48%)", "label": "CULTURE", "seed": "8b222ce941c5"}}, "published_date": "2026-10-20", "word_count": 261, "reading_minutes": 0.8, "lead": "リアリティ番組で人気のカイリー・ジェンナーさんが、下着大手ヴィクトリアズ・シークレットのファッションショーに初めて登場し、5000万ドル（約37億ポンド）の「ファンタジー・ブラ」を着用した。この起用をめぐって、称賛と批判が入り混じっている。", "lead_zh": "真人秀明星凯莉·詹娜首次登上内衣品牌维多利亚的秘密的时装秀，戴着一条价值5000万美元（约3700万英镑）的“梦幻文胸”亮相。这次选人引发了褒贬不一的反应。", "preview": "問題のブラは18金と4410個のダイヤモンドで作られ、これまでショーの目玉として扱われてきた。選ばれたモデルにとっては名誉であり、決定的な瞬間と見なされる。29歳のジェンナーさんが着用したことについて、一部のファンは喜んだが、経験豊富なスーパーモデルに機会を与えるべきだと批判する", "preview_zh": "这条文胸由18K金和4410颗钻石制成，多年来一直是秀场的重头戏。对获选的模特来说，这是一种荣誉，也被视为决定性的时刻。对于29岁的詹娜佩戴它，一些粉丝感到高兴，但也有很多人批评说，应该把机会给经验丰富的超模。", "has_audio": true, "audio": {"id": 707, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/72/ja_n2.mp3", "duration": 45.55, "size_bytes": 273168, "engine": "kokoro", "voice": "jf_alpha", "word_count": 168, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@e17722d/content/data/versions/719.json"}], "ja_n1": [{"content_hash": "4748a76e8198d6cc", "version_id": 720, "article_id": 72, "level_code": "ja_n1", "lang": "ja", "level": 5, "level_label": "N1 上級", "title": "カイリー・ジェンナー、5000万ドルのブラでヴィクトリアズ・シークレット初登場 賛否両論", "title_zh": "凯莉·詹娜戴着5000万美元胸罩首次亮相维密秀，引发两极反应", "has_translation": true, "topic": "culture", "source": "bbc_culture", "source_url": "https://www.bbc.co.uk/news/articles/cmx2wqwxvyxlo?at_medium=RSS&at_campaign=rss", "image": {"type": "photo", "url": "https://images.unsplash.com/flagged/photo-1557286249-08f5bc2ef21d?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MXx8a3lsaWUlMjBqZW5uZXJ8ZW58MHwwfHx8MTc5MjQ1NjMzNXww&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Joel Muniz on Unsplash", "author": "Joel Muniz", "credit_url": "https://unsplash.com/@jmuniz?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/man-pointing-forward-mXF1hOJ37BI?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(338, 42%, 62%)", "to": "hsl(16, 46%, 48%)", "label": "CULTURE", "seed": "8b222ce941c5"}}, "published_date": "2026-10-20", "word_count": 306, "reading_minutes": 1.0, "lead": "リアリティ番組出身のカイリー・ジェンナーさんが、ヴィクトリアズ・シークレットの年次ファッションショーに初登場し、話題の「ファンタジー・ブラ」を着用した。だが、その起用をめぐって称賛と批判が入り乱れている。", "lead_zh": "真人秀出身的凯莉·詹娜首次登上维多利亚的秘密年度时装秀，并佩戴了话题性的“梦幻胸罩”。然而，围绕这次起用，赞美与批评交织在一起。", "preview": "ジェンナーさんは29歳。18カラットの金と4410個のダイヤモンドで作られたとされる「ファンタジー・ブラ」を身に着け、観客を驚かせた。このブラは長年ショーの目玉とされ、選ばれたモデルにとっては名誉であり、キャリアを決定づける瞬間と見なされてきた。", "preview_zh": "詹娜今年29岁。她佩戴由18K金和4410颗钻石制成的“梦幻胸罩”登场，让观众大为惊讶。这款胸罩多年来一直是秀场的重头戏，被视为被选中模特的荣誉，也是决定其职业生涯的瞬间。", "has_audio": true, "audio": {"id": 708, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/72/ja_n1.mp3", "duration": 53.65, "size_bytes": 326448, "engine": "kokoro", "voice": "jf_alpha", "word_count": 194, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@e17722d/content/data/versions/720.json"}]}}}