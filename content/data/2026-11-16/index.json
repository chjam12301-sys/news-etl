rom": "hsl(82, 42%, 62%)", "to": "hsl(120, 46%, 48%)", "label": "TECH", "seed": "7ee29fdf7be5"}}, "published_date": "2026-11-16", "word_count": 90, "reading_minutes": 0.3, "lead": "新しいゲーム「GTA6」が11月19日に出ます。PC Magの調査で、多くの人が休みを取ると分かりました。", "lead_zh": "新游戏《GTA6》11月19日发售。PC Mag的调查显示，很多人打算请假。", "preview": "アメリカの大人のプレイヤーの8%が、この日に休みます。会社を休む人や、学校を休む人もいます。これは約1250万人です。", "preview_zh": "美国成年玩家中有8%会在当天请假。有人向公司请假，也有人向学校请假。这大约有1250万人。", "has_audio": true, "audio": {"id": 969, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/99/ja_n5.mp3", "duration": 20.8, "size_bytes": 124272, "engine": "kokoro", "voice": "jf_alpha", "word_count": 65, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@a147cc5f/content/data/versions/986.json"}], "ja_n4": [{"content_hash": "9a361ff0ad045287", "version_id": 987, "article_id": 99, "level_code": "ja_n4", "lang": "ja", "level": 2, "level_label": "N4 初級", "title": "「GTA6」のために休みを取る？アメリカで1250万人が計画", "title_zh": "为了《GTA6》请假？美国1250万人打算这么干", "has_translation": true, "topic": "tech", "source": "ithome", "source_url": "https://www.ithome.com/1/027/486.htm", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1717501216174-9dc275fe680d?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8M3x8bWFnfGVufDB8MHx8fDE3OTQ3OTE3ODd8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Doriana Popa on Unsplash", "author": "Doriana Popa", "credit_url": "https://unsplash.com/@ibreathart?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/a-table-topped-with-a-cake-and-flowers-XtPq1tkY7sA?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(82, 42%, 62%)", "to": "hsl(120, 46%, 48%)", "label": "TECH", "seed": "7ee29fdf7be5"}}, "published_date": "2026-11-16", "word_count": 140, "reading_minutes": 0.5, "lead": "アメリカの調査で、多くの人が新しいゲーム「GTA6」の発売日に仕事や学校を休むつもりだと分かりました。", "lead_zh": "美国一项调查发现，很多人打算在新游戏《GTA6》发售当天请假或翘课。", "preview": "アメリカのメディアPC Magが調べました。「GTA6」は11月19日に発売されます。アメリカの大人のゲームプレイヤーの8％が、この日に休みを取るか、仕事や学校の時間を変えると言いました。これは約1250万人です。", "preview_zh": "美国媒体PC Mag做了调查。《GTA6》将于11月19日发售。8%的美国成年玩家表示，当天会请假，或者调整上班、上学时间。这大约有1250万人。", "has_audio": true, "audio": {"id": 970, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/99/ja_n4.mp3", "duration": 30.3, "size_bytes": 181296, "engine": "kokoro", "voice": "jf_alpha", "word_count": 102, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@a147cc5f/content/data/versions/987.json"}], "ja_n3": [{"content_hash": "706f08c778f176d1", "version_id": 988, "article_id": 99, "level_code": "ja_n3", "lang": "ja", "level": 3, "level_label": "N3 中級", "title": "「GTA6」の発売日に休む予定の米国人、約1250万人に", "title_zh": "约1250万美国人打算在《GTA6》发售日请假", "has_translation": true, "topic": "tech", "source": "ithome", "source_url": "https://www.ithome.com/1/027/486.htm", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1717501216174-9dc275fe680d?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8M3x8bWFnfGVufDB8MHx8fDE3OTQ3OTE3ODd8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Doriana Popa on Unsplash", "author": "Doriana Popa", "credit_url": "https://unsplash.com/@ibreathart?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/a-table-topped-with-a-cake-and-flowers-XtPq1tkY7sA?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(82, 42%, 62%)", "to": "hsl(120, 46%, 48%)", "label": "TECH", "seed": "7ee29fdf7be5"}}, "published_date": "2026-11-16", "word_count": 198, "reading_minutes": 0.6, "lead": "人気ゲーム「GTA6」が11月19日に発売されます。米国の調査会社が調べたところ、この日に仕事や学校を休む予定の人が多いことが分かりました。", "lead_zh": "人气游戏《GTA6》将于11月19日发售。美国一家调查公司调查后发现，很多人打算在这一天请假不上班或不上学。", "preview": "科技媒体PC Magがこのほど発表した調査報告によると、米国の成人プレイヤーの8％が11月19日に有給休暇を取るか、仕事や学校の時間を調整する予定です。計算すると、約1250万人が新作を遊ぶためにわざわざ時間を作るということになります。", "preview_zh": "科技媒体PC Mag近日发布的调查报告显示，8%的美国成年玩家计划在11月19日请带薪假，或者调整上班、上学时间。算下来，大约有1250万人打算专门腾出时间来玩这款新作。", "has_audio": true, "audio": {"id": 971, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/99/ja_n3.mp3", "duration": 40.975, "size_bytes": 245952, "engine": "kokoro", "voice": "jf_alpha", "word_count": 135, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@a147cc5f/content/data/versions/988.json"}], "ja_n2": [{"content_hash": "fc098f5709d359ac", "version_id": 989, "article_id": 99, "level_code": "ja_n2", "lang": "ja", "level": 4, "level_label": "N2 中高級", "title": "「GTA6」発売日に休暇や欠席を計画する米国人、約1250万人に", "title_zh": "调查显示约1250万美国人打算在《GTA6》发售日请假或翘课", "has_translation": true, "topic": "tech", "source": "ithome", "source_url": "https://www.ithome.com/1/027/486.htm", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1717501216174-9dc275fe680d?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8M3x8bWFnfGVufDB8MHx8fDE3OTQ3OTE3ODd8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Doriana Popa on Unsplash", "author": "Doriana Popa", "credit_url": "https://unsplash.com/@ibreathart?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/a-table-topped-with-a-cake-and-flowers-XtPq1tkY7sA?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(82, 42%, 62%)", "to": "hsl(120, 46%, 48%)", "label": "TECH", "seed": "7ee29fdf7be5"}}, "published_date": "2026-11-16", "word_count": 282, "reading_minutes": 0.9, "lead": "米国のテクノロジーメディアPC Magがこのほど公表した調査によると、約1250万人の米国のプレイヤーが、人気ゲーム「GTA6」の発売日に合わせて仕事や学校の予定を調整するつもりでいることが分かった。", "lead_zh": "美国科技媒体PC Mag近日公布的调查显示，约1250万美国玩家打算配合热门游戏《GTA6》的发售日调整工作或上学安排。", "preview": "PC Magの調査によれば、回答した米国の成人プレイヤーのうち8％が11月19日の発売日に有給休暇を取るか、勤務や登校の時間を変更して、いち早く新作を遊ぶ計画を持っている。これを米国のプレイヤー全体に当てはめると、約1250万人が同作のために予定を空ける計算になる。", "preview_zh": "据PC Mag调查，受访的美国成年玩家中有8%计划在11月19日发售当天请带薪假，或调整上班、上学时间，以便第一时间玩到新作。按全美玩家规模换算，约1250万人将为这款游戏腾出时间。", "has_audio": true, "audio": {"id": 972, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/99/ja_n2.mp3", "duration": 62.25, "size_bytes": 372960, "engine": "kokoro", "voice": "jf_alpha", "word_count": 205, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@a147cc5f/content/data/versions/989.json"}], "ja_n1": [{"content_hash": "a295b439a032e9df", "version_id": 990, "article_id": 99, "level_code": "ja_n1", "lang": "ja", "level": 5, "level_label": "N1 上級", "title": "「GTA6」発売日に休暇を取る米国人、PC Mag調査で1250万人規模と判明", "title_zh": "PC Mag调查：约1250万美国人打算在《GTA6》发售日请假", "has_translation": true, "topic": "tech", "source": "ithome", "source_url": "https://www.ithome.com/1/027/486.htm", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1717501216174-9dc275fe680d?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8M3x8bWFnfGVufDB8MHx8fDE3OTQ3OTE3ODd8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Doriana Popa on Unsplash", "author": "Doriana Popa", "credit_url": "https://unsplash.com/@ibreathart?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/a-table-topped-with-a-cake-and-flowers-XtPq1tkY7sA?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(82, 42%, 62%)", "to": "hsl(120, 46%, 48%)", "label": "TECH", "seed": "7ee29fdf7be5"}}, "published_date": "2026-11-16", "word_count": 336, "reading_minutes": 1.1, "lead": "人気ゲーム「グランド・セフト・オート6（GTA6）」の発売日である11月19日、仕事や学業を調整して真っ先にプレーしようと考える米国人が1000万人規模に上ることが分かった。PC Magの委託調査が明らかにした。", "lead_zh": "科技媒体PC Mag委托的调查显示，约上千万美国人打算在《GTA6》11月19日发售当天调整上班或上学时间，只为第一时间玩上这款大作。", "preview": "PC Magが公表した調査報告書によれば、米国の成人ゲーマーのうち8%が11月19日に有給休暇を取得するか、勤務・通学の時間を変更して「GTA6」をいち早く体験する予定だという。単純計算すると、約1250万人の米国人プレーヤーが新作のためにあえて日程を空けることになり、発売日を巡", "preview_zh": "PC Mag公布的调查报告显示，美国成年玩家中有8%打算在11月19日请带薪假，或调整上班、上学时间，以便第一时间体验《GTA6》。简单推算，这意味着约1250万美国玩家要为这款新作专门腾出时间，发售日的热度可见一斑。", "has_audio": true, "audio": {"id": 973, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/99/ja_n1.mp3", "duration": 69.425, "size_bytes": 419904, "engine": "kokoro", "voice": "jf_alpha", "word_count": 241, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@a147cc5f/content/data/versions/990.json"}]}}}