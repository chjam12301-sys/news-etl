DB8fHwxNzk1MzExMDg5fDA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Julio Lopez on Unsplash", "author": "Julio Lopez", "credit_url": "https://unsplash.com/@juliolopez?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/a-person-holding-up-a-cell-phone-in-front-of-a-sign-ilbjfRwOgzA?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(186, 42%, 62%)", "to": "hsl(224, 46%, 48%)", "label": "BUSINESS", "seed": "8382d9bae0e2"}}, "published_date": "2026-11-22", "word_count": 71, "reading_minutes": 0.3, "lead": "世界のAIめがねは、アメリカのメタがとても強いです。中国では、まだ一社が勝っていません。", "lead_zh": "全球AI眼镜市场，美国Meta一家独大。在中国，还没有哪家公司占绝对优势。", "preview": "2025年、世界で870万のAIめがねが売れました。その85.2%はメタです。メタはレイバンと組み、ふつうのめがねに近い形で売っています。", "preview_zh": "2025年全球卖出870万副AI眼镜，其中85.2%来自Meta。Meta与雷朋合作，产品外形接近普通眼镜。", "has_audio": true, "audio": {"id": 1029, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/105/ja_n5.mp3", "duration": 20.7, "size_bytes": 128304, "engine": "kokoro", "voice": "jf_alpha", "word_count": 55, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@9aa203d0/content/data/versions/1046.json"}], "ja_n4": [{"content_hash": "5930d4a0dfb435c7", "version_id": 1047, "article_id": 105, "level_code": "ja_n4", "lang": "ja", "level": 2, "level_label": "N4 初級", "title": "中国のAIメガネ市場、Metaに追いつけず各社が競争", "title_zh": "中国AI眼镜市场群雄混战，仍追不上Meta", "has_translation": true, "topic": "business", "source": "tmtpost", "source_url": "https://www.tmtpost.com/8213674.html", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1689439518196-f48a24b49fb5?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8OHx8bWV0YXxlbnwwfDB8fHwxNzk1MzExMDg5fDA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Julio Lopez on Unsplash", "author": "Julio Lopez", "credit_url": "https://unsplash.com/@juliolopez?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/a-person-holding-up-a-cell-phone-in-front-of-a-sign-ilbjfRwOgzA?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(186, 42%, 62%)", "to": "hsl(224, 46%, 48%)", "label": "BUSINESS", "seed": "8382d9bae0e2"}}, "published_date": "2026-11-22", "word_count": 118, "reading_minutes": 0.5, "lead": "世界のAIメガネ市場ではMetaが8割以上のシェアを持っています。中国ではAlibabaやXiaomiなど多くの会社が参入しましたが、まだ勝者は決まっていません。", "lead_zh": "全球AI眼镜市场里，Meta占了八成以上的份额。在中国，Alibaba、Xiaomi等许多公司加入竞争，但还没有出现赢家。", "preview": "Omdiaによると、2026年前半にMetaは世界で340万個を出荷し、シェアは81.3%でした。2位の会社の30倍以上です。一方、中国の上位3社Alibaba、INMO、Xiaomiを合わせても46.1%でした。", "preview_zh": "据Omdia数据，2026年上半年Meta全球出货340万副，份额81.3%，是第二名公司的30多倍。而中国前三名Alibaba、INMO、Xiaomi合计也只有46.1%。", "has_audio": true, "audio": {"id": 1030, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/105/ja_n4.mp3", "duration": 13.8, "size_bytes": 208800, "engine": "kokoro", "voice": "jf_alpha", "word_count": 69, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@9aa203d0/content/data/versions/1047.json"}], "ja_n3": [{"content_hash": "925fa6b8f1f2879e", "version_id": 1048, "article_id": 105, "level_code": "ja_n3", "lang": "ja", "level": 3, "level_label": "N3 中級", "title": "Metaが世界のAI眼鏡市場を独走、中国勢は乱戦のまま", "title_zh": "Meta在全球AI眼镜市场一家独大，中国厂商还在混战", "has_translation": true, "topic": "business", "source": "tmtpost", "source_url": "https://www.tmtpost.com/8213674.html", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1689439518196-f48a24b49fb5?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8OHx8bWV0YXxlbnwwfDB8fHwxNzk1MzExMDg5fDA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Julio Lopez on Unsplash", "author": "Julio Lopez", "credit_url": "https://unsplash.com/@juliolopez?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/a-person-holding-up-a-cell-phone-in-front-of-a-sign-ilbjfRwOgzA?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(186, 42%, 62%)", "to": "hsl(224, 46%, 48%)", "label": "BUSINESS", "seed": "8382d9bae0e2"}}, "published_date": "2026-11-22", "word_count": 141, "reading_minutes": 0.6, "lead": "AI眼鏡の市場で、Metaが世界の8割以上を握っています。一方、中国では多くのメーカーが競い合い、まだ勝者が決まっていません。なぜ中国から第二のMetaが出てこないのでしょうか。", "lead_zh": "在AI眼镜市场，Meta拿下了全球八成以上的份额。而在中国，众多厂商互相竞争，还没分出胜负。为什么中国迟迟出不了第二个Meta呢？", "preview": "調査会社Omdiaによると、2025年の世界のAI眼鏡の出荷台数は870万台で、そのうちMetaが85.2%を占めました。Metaは2023年にカメラや音声AIを付けた「Ray-Ban Meta」を出し、ふつうの眼鏡に近い見た目で人気を集めました。", "preview_zh": "据调查公司Omdia的数据，2025年全球AI眼镜出货量为870万台，其中Meta占了85.2%。Meta在2023年推出带摄像头和语音AI的“Ray-Ban Meta”，外观接近普通眼镜，很受欢迎。", "has_audio": true, "audio": {"id": 1031, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/105/ja_n3.mp3", "duration": 15.175, "size_bytes": 237744, "engine": "kokoro", "voice": "jf_alpha", "word_count": 70, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@9aa203d0/content/data/versions/1048.json"}], "ja_n2": [{"content_hash": "f6d8b885898db38d", "version_id": 1049, "article_id": 105, "level_code": "ja_n2", "lang": "ja", "level": 4, "level_label": "N2 中高級", "title": "Metaが世界のAI眼鏡市場を独占する中、中国勢は依然として混戦", "title_zh": "Meta独霸全球AI眼镜市场，中国厂商还在混战", "has_translation": true, "topic": "business", "source": "tmtpost", "source_url": "https://www.tmtpost.com/8213674.html", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1689439518196-f48a24b49fb5?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8OHx8bWV0YXxlbnwwfDB8fHwxNzk1MzExMDg5fDA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Julio Lopez on Unsplash", "author": "Julio Lopez", "credit_url": "https://unsplash.com/@juliolopez?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/a-person-holding-up-a-cell-phone-in-front-of-a-sign-ilbjfRwOgzA?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(186, 42%, 62%)", "to": "hsl(224, 46%, 48%)", "label": "BUSINESS", "seed": "8382d9bae0e2"}}, "published_date": "2026-11-22", "word_count": 225, "reading_minutes": 0.9, "lead": "世界のAI眼鏡市場ではMetaが8割超のシェアを握る一方、中国市場はAlibabaやXiaomiなど複数の企業が競い合い、首位が定まらない。中国でなぜ第二のMetaが生まれないのか、その背景を探る。", "lead_zh": "全球AI眼镜市场上Meta占据八成以上份额，而中国市场则是Alibaba、Xiaomi等多家企业混战，无人稳居第一。为什么中国迟迟出不了第二个Meta？本文梳理背后原因。", "preview": "Omdiaのデータによると、2026年上半期の世界のAI眼鏡出荷台数でMetaは81.3%を占め、2位以下を大きく引き離した。2025年の世界出荷は870万台で、Metaだけで85.2%に達する。一方、中国市場の上位3社であるAlibaba、INMO、Xiaomiの合計シェアは4", "preview_zh": "据Omdia数据，2026年上半年全球AI眼镜出货中Meta占81.3%，远超第二名。2025年全球出货870万台，Meta一家就占85.2%。而中国市场前三名Alibaba、INMO、Xiaomi合计份额仅46.1%，没有绝对领先者。", "has_audio": true, "audio": {"id": 1032, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/105/ja_n2.mp3", "duration": 51.2, "size_bytes": 383472, "engine": "kokoro", "voice": "jf_alpha", "word_count": 95, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@9aa203d0/content/data/versions/1049.json"}], "ja_n1": [{"content_hash": "df3559f6dafb5956", "version_id": 1050, "article_id": 105, "level_code": "ja_n1", "lang": "ja", "level": 5, "level_label": "N1 上級", "title": "Metaが世界のAI眼鏡市場を席巻、中国勢は群雄割拠の様相", "title_zh": "Meta独霸全球AI眼镜市场，中国厂商还在混战", "has_translation": true, "topic": "business", "source": "tmtpost", "source_url": "https://www.tmtpost.com/8213674.html", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1689439518196-f48a24b49fb5?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8OHx8bWV0YXxlbnwwfDB8fHwxNzk1MzExMDg5fDA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Julio Lopez on Unsplash", "author": "Julio Lopez", "credit_url": "https://unsplash.com/@juliolopez?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/a-person-holding-up-a-cell-phone-in-front-of-a-sign-ilbjfRwOgzA?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(186, 42%, 62%)", "to": "hsl(224, 46%, 48%)", "label": "BUSINESS", "seed": "8382d9bae0e2"}}, "published_date": "2026-11-22", "word_count": 250, "reading_minutes": 1.0, "lead": "世界のAI眼鏡市場ではMetaが8割超のシェアを握り、圧倒的な優位を確立している。一方、中国市場はXiaomiやAlibaba、雷鸟など多数の企業が覇を競う混戦状態にあり、首位の座はまだ定まっていない。", "lead_zh": "全球AI眼镜市场上，Meta拿下超过八成份额，优势压倒性。而中国市场则是Xiaomi、Alibaba、雷鸟等多家企业混战，头把交椅尚未确定。", "preview": "Omdiaの調査によれば、2026年上半期の世界出荷台数でMetaは81.3%を占め、2位に10万2000台にとどまったEven Realitiesを30倍以上引き離した。Metaは2021年にEssilorLuxotticaと組み、カメラや音声機能を眼鏡に搭載したRay-Ban", "preview_zh": "据Omdia调查，2026年上半年全球出货量中Meta占81.3%，把仅10.2万台的第二名Even Realities甩开30倍以上。Meta于2021年联手EssilorLuxottica推出搭载摄像头和音频的Ray-Ban Stories，但起初受续航和连接问题困扰，未能普", "has_audio": true, "audio": {"id": 1033, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/105/ja_n1.mp3", "duration": 68.575, "size_bytes": 416160, "engine": "kokoro", "voice": "jf_alpha", "word_count": 181, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@9aa203d0/content/data/versions/1050.json"}]}}}