url": "https://unsplash.com/@amr_taha?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/black-flat-screen-computer-monitor-on-brown-wooden-desk-SMMqej67qjI?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(350, 42%, 62%)", "to": "hsl(28, 46%, 48%)", "label": "LIFESTYLE", "seed": "40a674dce8b1"}}, "published_date": "2026-11-17", "word_count": 148, "reading_minutes": 0.5, "lead": "Beatsが10月13日に発売した、ポケモンとコラボしたスピーカー「Beats Pill」が人気です。今は買いにくくなっています。", "lead_zh": "Beats在10月13日推出的宝可梦联名音箱Beats Pill很受欢迎，现在已经不好买了。", "preview": "この商品はアップルのオンラインストアとBeatsのDouyin店だけで売っています。発売してすぐに売り切れました。今はふつうの値段で買うのが難しいです。", "preview_zh": "这款产品只在苹果官网和Beats的Douyin店卖，一上市就卖光了。现在很难用原价买到。", "has_audio": true, "audio": {"id": 980, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/100/ja_n4.mp3", "duration": 26.375, "size_bytes": 157968, "engine": "kokoro", "voice": "jf_alpha", "word_count": 85, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@51ca64de/content/data/versions/997.json"}], "ja_n3": [{"content_hash": "5a711c21d0d46280", "version_id": 998, "article_id": 100, "level_code": "ja_n3", "lang": "ja", "level": 3, "level_label": "N3 中級", "title": "Beatsとポケモンの特別版スピーカーが完売、定価で買えない人気に", "title_zh": "Beats与宝可梦联名特别版音箱售罄，原价已经买不到了", "has_translation": true, "topic": "lifestyle", "source": "toodaylab", "source_url": "https://www.toodaylab.com/84293", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1610366398516-46da9dec5931?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MXx8YmVhdHMlMjBkZXNrJTIwc2V0dXB8ZW58MHwwfHx8MTc5NDg4ODI4OHww&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Amr Taha™ on Unsplash", "author": "Amr Taha™", "credit_url": "https://unsplash.com/@amr_taha?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/black-flat-screen-computer-monitor-on-brown-wooden-desk-SMMqej67qjI?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(350, 42%, 62%)", "to": "hsl(28, 46%, 48%)", "label": "LIFESTYLE", "seed": "40a674dce8b1"}}, "published_date": "2026-11-17", "word_count": 169, "reading_minutes": 0.6, "lead": "Beatsとポケモンのコラボ商品が10月に発売され、すぐに売り切れました。ふつうの聯名とは違う、細かい工夫がたくさん入った一台です。", "lead_zh": "Beats与宝可梦的联名产品10月开卖后很快售罄。这台音箱和普通联名不一样，里面有很多用心的设计。", "preview": "この特別版Beats Pillは10月13日に発売され、売り場はAppleの公式オンラインストアとBeatsのDouyin公式店だけでした。今はもう買いにくくなっていて、転売では定価の2〜3倍の値段も見られます。人気の高さがわかりますね。", "preview_zh": "这款特别版Beats Pill于10月13日发售，渠道只有苹果官网商店和Beats的Douyin官方旗舰店。现在很难买到，代购价格甚至达到原价的2到3倍，可见人气之高。", "has_audio": true, "audio": {"id": 981, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/100/ja_n3.mp3", "duration": 34.2, "size_bytes": 208512, "engine": "kokoro", "voice": "jf_alpha", "word_count": 119, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@51ca64de/content/data/versions/998.json"}], "ja_n2": [{"content_hash": "8867bb44ad1c9eb4", "version_id": 999, "article_id": 100, "level_code": "ja_n2", "lang": "ja", "level": 4, "level_label": "N2 中高級", "title": "Beatsとポケモンの限定スピーカーが完売、遊び心ある設計が話題に", "title_zh": "Beats与宝可梦联名限定音箱售罄，巧妙设计引发热议", "has_translation": true, "topic": "lifestyle", "source": "toodaylab", "source_url": "https://www.toodaylab.com/84293", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1610366398516-46da9dec5931?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MXx8YmVhdHMlMjBkZXNrJTIwc2V0dXB8ZW58MHwwfHx8MTc5NDg4ODI4OHww&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Amr Taha™ on Unsplash", "author": "Amr Taha™", "credit_url": "https://unsplash.com/@amr_taha?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/black-flat-screen-computer-monitor-on-brown-wooden-desk-SMMqej67qjI?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(350, 42%, 62%)", "to": "hsl(28, 46%, 48%)", "label": "LIFESTYLE", "seed": "40a674dce8b1"}}, "published_date": "2026-11-17", "word_count": 256, "reading_minutes": 0.8, "lead": "Beatsとポケモン国際会社が共同開発した特別版「Beats Pill」が10月13日に発売され、ほどなく完売した。デザインの細部に多くの新機軸が盛り込まれ、注目を集めている。", "lead_zh": "Beats与宝可梦国际公司联合推出的特别版Beats Pill于10月13日发售，很快就售罄。设计细节中融入了许多新意，引发广泛关注。", "preview": "この特別版はAppleの公式オンラインストアとBeatsのDouyin公式旗艦店のみで販売され、現在は入手が難しい状況である。転売価格は定価の2～3倍に達しており、今回のコラボへの評価の高さがうかがえる。", "preview_zh": "这款特别版仅在Apple官方在线商店和Beats的Douyin官方旗舰店销售，目前已经很难买到。转卖价格达到定价的2到3倍，可见此次联名评价之高。", "has_audio": true, "audio": {"id": 982, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/100/ja_n2.mp3", "duration": 19.95, "size_bytes": 282528, "engine": "kokoro", "voice": "jf_alpha", "word_count": 65, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@51ca64de/content/data/versions/999.json"}], "ja_n1": [{"content_hash": "1693b64949f74080", "version_id": 1000, "article_id": 100, "level_code": "ja_n1", "lang": "ja", "level": 5, "level_label": "N1 上級", "title": "Beatsとポケモンの特別版「Beats Pill」が即完売、その人気の理由", "title_zh": "Beats与宝可梦联名特别版Beats Pill迅速售罄，揭秘火爆原因", "has_translation": true, "topic": "lifestyle", "source": "toodaylab", "source_url": "https://www.toodaylab.com/84293", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1610366398516-46da9dec5931?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MXx8YmVhdHMlMjBkZXNrJTIwc2V0dXB8ZW58MHwwfHx8MTc5NDg4ODI4OHww&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Amr Taha™ on Unsplash", "author": "Amr Taha™", "credit_url": "https://unsplash.com/@amr_taha?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/black-flat-screen-computer-monitor-on-brown-wooden-desk-SMMqej67qjI?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(350, 42%, 62%)", "to": "hsl(28, 46%, 48%)", "label": "LIFESTYLE", "seed": "40a674dce8b1"}}, "published_date": "2026-11-17", "word_count": 328, "reading_minutes": 1.1, "lead": "米Apple傘下のBeatsがポケモン国際会社と組んだ特別版「Beats Pill」が10月13日に発売され、ほどなく完売した。単なるロゴ合わせを超えた作り込みが話題を呼んでいる。", "lead_zh": "苹果旗下Beats与宝可梦国际公司合作的特别版Beats Pill于10月13日发售，很快售罄。超越简单logo叠加的精心设计引发热议。", "preview": "特別版の発売チャネルはApple公式オンラインストアとBeatsのDouyin公式旗艦店に限られ、現在は定価での入手が困難となっている。転売価格は定価の2〜3倍に達する例もあり、需要の高さがうかがえる。Beatsは従来から聯名の常連だが、今回はデザイン面で異例の力の入れようを見せ", "preview_zh": "特别版仅限苹果官网商店和Beats抖音官方旗舰店发售，如今已难以按原价买到。部分代购渠道价格达到原价的兩三倍，足见需求之高。Beats向来是联名常客，但此次在设计上展现出罕见的投入。", "has_audio": true, "audio": {"id": 983, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/100/ja_n1.mp3", "duration": 24.6, "size_bytes": 389808, "engine": "kokoro", "voice": "jf_alpha", "word_count": 94, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@51ca64de/content/data/versions/1000.json"}]}}}