加州通过对富豪一次性征税的提案，这些股票可被出售以支付数十亿美元的税单。作为交换，他承诺在未来", "has_audio": true, "audio": {"id": 743, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/76/en_c1.mp3", "duration": 116.825, "size_bytes": 701856, "engine": "kokoro", "voice": "af_heart", "word_count": 334, "has_timeline": true, "alternates": [{"voice": "af_bella", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/76/en_c1_af_bella.mp3", "duration": 119.25, "size_bytes": 716400, "engine": "kokoro", "word_count": 334, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/76/en_c1_af_bella.json"}, {"voice": "am_michael", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/76/en_c1_am_michael.mp3", "duration": 127.825, "size_bytes": 767952, "engine": "kokoro", "word_count": 334, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/76/en_c1_am_michael.json"}, {"voice": "bf_emma", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/76/en_c1_bf_emma.mp3", "duration": 110.475, "size_bytes": 663840, "engine": "kokoro", "word_count": 334, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/76/en_c1_bf_emma.json"}, {"voice": "bm_george", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/76/en_c1_bm_george.mp3", "duration": 119.825, "size_bytes": 719856, "engine": "kokoro", "word_count": 334, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/76/en_c1_bm_george.json"}]}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@7da7786/content/data/versions/755.json"}]}, "ja": {"ja_n5": [{"content_hash": "b1e1e8af1501ea39", "version_id": 756, "article_id": 76, "level_code": "ja_n5", "lang": "ja", "level": 1, "level_label": "N5 初級", "title": "メタ、ザッカーバーグさんに新しい株 カリフォルニアの税金のため", "title_zh": "Meta给扎克伯格新股票，帮他应对加州富人税", "has_translation": true, "topic": "tech", "source": "guardian_tech", "source_url": "https://www.theguardian.com/technology/2026/oct/22/meta-mark-zuckerberg-california-wealth-tax", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1689439518196-f48a24b49fb5?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8Mnx8bWV0YSUyMHN0cmlrZXMlMjBkZWFsfGVufDB8MHx8fDE3OTI3OTk4NTF8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Julio Lopez on Unsplash", "author": "Julio Lopez", "credit_url": "https://unsplash.com/@juliolopez?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/a-person-holding-up-a-cell-phone-in-front-of-a-sign-ilbjfRwOgzA?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(112, 42%, 62%)", "to": "hsl(150, 46%, 48%)", "label": "TECH", "seed": "ba10886f1e8e"}}, "published_date": "2026-10-24", "word_count": 89, "reading_minutes": 0.3, "lead": "アメリカのメタという会社が、ザッカーバーグさんと約束をしました。カリフォルニアの新しい税金のためです。", "lead_zh": "美国Meta公司跟扎克伯格达成了约定，是为了加州的一项新税。", "preview": "カリフォルニアでは、お金持ちに5%の税金をかける案があります。来月、住民が投票します。", "preview_zh": "加州有一项对富人征收5%税的方案，下个月居民将投票表决。", "has_audio": true, "audio": {"id": 744, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/76/ja_n5.mp3", "duration": 16.95, "size_bytes": 106128, "engine": "kokoro", "voice": "jf_alpha", "word_count": 58, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@7da7786/content/data/versions/756.json"}], "ja_n4": [{"content_hash": "9be7071a07b4c0db", "version_id": 757, "article_id": 76, "level_code": "ja_n4", "lang": "ja", "level": 2, "level_label": "N4 初級", "title": "メタ、ザッカーバーグ氏の税金を助ける契約を発表", "title_zh": "Meta宣布帮扎克伯格交税的新协议", "has_translation": true, "topic": "tech", "source": "guardian_tech", "source_url": "https://www.theguardian.com/technology/2026/oct/22/meta-mark-zuckerberg-california-wealth-tax", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1689439518196-f48a24b49fb5?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8Mnx8bWV0YSUyMHN0cmlrZXMlMjBkZWFsfGVufDB8MHx8fDE3OTI3OTk4NTF8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Julio Lopez on Unsplash", "author": "Julio Lopez", "credit_url": "https://unsplash.com/@juliolopez?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/a-person-holding-up-a-cell-phone-in-front-of-a-sign-ilbjfRwOgzA?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(112, 42%, 62%)", "to": "hsl(150, 46%, 48%)", "label": "TECH", "seed": "ba10886f1e8e"}}, "published_date": "2026-10-24", "word_count": 165, "reading_minutes": 0.5, "lead": "アメリカのカリフォルニア州で、お金持ちに税金をかける案があります。メタは、ザッカーバーグCEOがその税金を払えるように、新しい契約をしました。", "lead_zh": "美国加州正在讨论一项对富人征税的提案。Meta公司为了让CEO扎克伯格能交这笔税，签了一份新协议。", "preview": "メタは水曜日の夜、ザッカーバーグCEOと契約したと発表しました。新しい株を彼に渡し、税金を払うお金にできるようにします。その代わり、彼は8年間カリフォルニアに住み続けます。", "preview_zh": "Meta周三晚上宣布，已与CEO扎克伯格签订协议。公司将给他新股票，让他可以卖掉交税。作为交换，他承诺未来8年继续住在加州。", "has_audio": true, "audio": {"id": 745, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/76/ja_n4.mp3", "duration": 31.125, "size_bytes": 186624, "engine": "kokoro", "voice": "jf_alpha", "word_count": 105, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@7da7786/content/data/versions/757.json"}], "ja_n3": [{"content_hash": "580aac5bef28fb1e", "version_id": 758, "article_id": 76, "level_code": "ja_n3", "lang": "ja", "level": 3, "level_label": "N3 中級", "title": "メタ、ザッカーバーグ氏の税負担を助ける契約を発表", "title_zh": "Meta宣布与扎克伯格达成协议，帮他交税", "has_translation": true, "topic": "tech", "source": "guardian_tech", "source_url": "https://www.theguardian.com/technology/2026/oct/22/meta-mark-zuckerberg-california-wealth-tax", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1689439518196-f48a24b49fb5?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8Mnx8bWV0YSUyMHN0cmlrZXMlMjBkZWFsfGVufDB8MHx8fDE3OTI3OTk4NTF8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Julio Lopez on Unsplash", "author": "Julio Lopez", "credit_url": "https://unsplash.com/@juliolopez?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/a-person-holding-up-a-cell-phone-in-front-of-a-sign-ilbjfRwOgzA?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(112, 42%, 62%)", "to": "hsl(150, 46%, 48%)", "label": "TECH", "seed": "ba10886f1e8e"}}, "published_date": "2026-10-24", "word_count": 209, "reading_minutes": 0.7, "lead": "アメリカのカリフォルニア州では、お金持ちに一度だけ税金をかける案が話し合われています。メタは、この税金でザッカーバーグ氏の負担が大きくならないように、新しい契約を結びました。", "lead_zh": "美国加州正在讨论对富人征收一次性税款的方案。Meta为此签订新协议，以免扎克伯格因此背上沉重税负。", "preview": "メタは水曜日の夜、フェイスブックやインスタグラムを運営する会社として、ザッカーバーグ最高経営責任者（CEO）と契約を結んだと明らかにしました。この契約で、同氏は8年間カリフォルニア州に住み続けることになります。", "preview_zh": "Meta周三晚间宣布，作为运营Facebook和Instagram的公司，已与CEO扎克伯格签订协议。根据协议，他将在未来8年继续住在加州。", "has_audio": true, "audio": {"id": 746, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/76/ja_n3.mp3", "duration": 40.45, "size_bytes": 242208, "engine": "kokoro", "voice": "jf_alpha", "word_count": 133, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@7da7786/content/data/versions/758.json"}], "ja_n2": [{"content_hash": "69c8f7fbcb6908ce", "version_id": 759, "article_id": 76, "level_code": "ja_n2", "lang": "ja", "level": 4, "level_label": "N2 中高級", "title": "メタ、ザッカーバーグ氏と合意 巨額富裕税に備え新株発行へ", "title_zh": "Meta与扎克伯格达成协议，发新股帮他应对巨额富豪税", "has_translation": true, "topic": "tech", "source": "guardian_tech", "source_url": "https://www.theguardian.com/technology/2026/oct/22/meta-mark-zuckerberg-california-wealth-tax", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1689439518196-f48a24b49fb5?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8Mnx8bWV0YSUyMHN0cmlrZXMlMjBkZWFsfGVufDB8MHx8fDE3OTI3OTk4NTF8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Julio Lopez on Unsplash", "author": "Julio Lopez", "credit_url": "https://unsplash.com/@juliolopez?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/a-person-holding-up-a-cell-phone-in-front-of-a-sign-ilbjfRwOgzA?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(112, 42%, 62%)", "to": "hsl(150, 46%, 48%)", "label": "TECH", "seed": "ba10886f1e8e"}}, "published_date": "2026-10-24", "word_count": 207, "reading_minutes": 0.6, "lead": "メタは、カリフォルニア州で検討されている富豪向けの一時的な富裕税に備え、最高経営責任者（CEO）のマーク・ザッカーバーグ氏と合意したと発表した。新たな株式を発行し、同氏が税負担に備えられるようにする一方、同氏は8年間カリフォーニアにとどまることを約束した。", "lead_zh": "Meta宣布，已与首席执行官马克·扎克伯格达成协议，以应对加州正在讨论的一次性富豪税。公司将发行新股，让扎克伯格有能力承担税负；作为交换，他承诺未来八年继续留在加州。", "preview": "メタは水曜日夜、フェイスブックやインスタグラムを運営する同社のCEOであるザッカーバーグ氏と合意したと明らかにした。合意により、同氏は新しい株式を受け取り、カリフォルニア州が一時的な富裕税を可決した場合に、その売却益を巨額の税負担に充てることができる。見返りに同氏は、今後8年間、", "preview_zh": "Meta周三晚间透露，已与旗下Facebook和Instagram的首席执行官扎克伯格达成协议。根据协议，他将获得新股，一旦加州通过一次性富豪税，他就可以出售这些股票来支付巨额税款。作为交换，他承诺未来八年继续居住在加州或Meta总部所在地。", "has_audio": true, "audio": {"id": 747, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/76/ja_n2.mp3", "duration": 36.775, "size_bytes": 224064, "engine": "kokoro", "voice": "jf_alpha", "word_count": 128, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@7da7786/content/data/versions/759.json"}], "ja_n1": [{"content_hash": "09237e9b1e7a6dae", "version_id": 760, "article_id": 76, "level_code": "ja_n1", "lang": "ja", "level": 5, "level_label": "N1 上級", "title": "メタ、ザッカーバーグ氏の巨額税負担を支援する取引を締結", "title_zh": "Meta和扎克伯格达成协议，帮他分担巨额富人税", "has_translation": true, "topic": "tech", "source": "guardian_tech", "source_url": "https://www.theguardian.com/technology/2026/oct/22/meta-mark-zuckerberg-california-wealth-tax", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1689439518196-f48a24b49fb5?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8Mnx8bWV0YSUyMHN0cmlrZXMlMjBkZWFsfGVufDB8MHx8fDE3OTI3OTk4NTF8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Julio Lopez on Unsplash", "author": "Julio Lopez", "credit_url": "https://unsplash.com/@juliolopez?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/a-person-holding-up-a-cell-phone-in-front-of-a-sign-ilbjfRwOgzA?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(112, 42%, 62%)", "to": "hsl(150, 46%, 48%)", "label": "TECH", "seed": "ba10886f1e8e"}}, "published_date": "2026-10-24", "word_count": 348, "reading_minutes": 1.1, "lead": "カリフォルニア州で富豪を対象とした一時的な富裕税が成立する可能性が高まるなか、メタは最高経営責任者マーク・ザッカーバーグ氏の税負担を支援する異例の取り決めを発表した。同氏は州内に留まることを約束する一方、新たな種類の株式を受け取る。", "lead_zh": "随着加州针对富豪的一次性财富税有可能通过，Meta公布了一项罕见的安排，帮助CEO马克·扎克伯格分担税负。他承诺留在州内，同时将获得一种新股。", "preview": "フェイスブックやインスタグラム、ワッツアップを傘下に持つメタは水曜夜、この取り決めによってザッカーバーグ氏が本社所在地であるカリフォルニア州に住み続けることになると明らかにした。同氏は、州が一時的な富裕税を可決した場合に数十億ドル規模の税負担を賄いうる新株を受け取る代わりに、今後", "preview_zh": "旗下拥有Facebook、Instagram和WhatsApp的Meta周三晚间表示，这项安排将让扎克伯格继续住在公司总部所在的加州。作为交换，他将获得一批新股，一旦州政府通过一次性财富税，这批股票可用来支付数十亿美元的税单；他则承诺未来八年继续居住在加州或Meta设有基地的地方", "has_audio": true, "audio": {"id": 748, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/76/ja_n1.mp3", "duration": 63.65, "size_bytes": 387360, "engine": "kokoro", "voice": "jf_alpha", "word_count": 226, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@7da7786/content/data/versions/760.json"}]}}}