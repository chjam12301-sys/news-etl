 "https://images.unsplash.com/photo-1612287230202-1ff1d85d1bdf?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MXx8ZGxjJTIwdmlkZW8lMjBnYW1lJTIwY29udHJvbGxlcnxlbnwwfDB8fHwxNzkzMjM2MjEzfDA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Javier Martínez on Unsplash", "author": "Javier Martínez", "credit_url": "https://unsplash.com/@cjdante?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/game-controller-in-neon-light-hUD0PUczwJQ?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(176, 42%, 62%)", "to": "hsl(214, 46%, 48%)", "label": "CULTURE", "seed": "5ab094f0a0ba"}}, "published_date": "2026-10-29", "word_count": 85, "reading_minutes": 0.3, "lead": "ゲーム『Farming Simulator 25』に、新しい追加コンテンツ「Beans & Alpacas」が出ました。南アメリカの農場で遊べます。", "lead_zh": "游戏《模拟农场25》推出了新的付费DLC“Beans & Alpacas”，可以在南美洲的农场里游玩。", "preview": "新しい農場の名前は「Catuaí」です。ブラジルのコーヒー農園がモデルです。赤い土と緑の山があります。", "preview_zh": "新农场叫“Catuaí”，以巴西的咖啡种植园为原型，有红土和绿色的山丘。", "has_audio": true, "audio": {"id": 789, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/81/ja_n5.mp3", "duration": 16.5, "size_bytes": 103104, "engine": "kokoro", "voice": "jf_alpha", "word_count": 54, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@dcbf67c/content/data/versions/806.json"}], "ja_n4": [{"content_hash": "53db91a2bf73311f", "version_id": 807, "article_id": 81, "level_code": "ja_n4", "lang": "ja", "level": 2, "level_label": "N4 初級", "title": "ゲーム「ファーミングシミュレーター25」に南米の新エリア、有料DLCが発売", "title_zh": "《模拟农场25》推出南美新区域付费DLC", "has_translation": true, "topic": "culture", "source": "gcores", "source_url": "https://www.gcores.com/articles/221607", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1612287230202-1ff1d85d1bdf?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MXx8ZGxjJTIwdmlkZW8lMjBnYW1lJTIwY29udHJvbGxlcnxlbnwwfDB8fHwxNzkzMjM2MjEzfDA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Javier Martínez on Unsplash", "author": "Javier Martínez", "credit_url": "https://unsplash.com/@cjdante?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/game-controller-in-neon-light-hUD0PUczwJQ?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(176, 42%, 62%)", "to": "hsl(214, 46%, 48%)", "label": "CULTURE", "seed": "5ab094f0a0ba"}}, "published_date": "2026-10-29", "word_count": 150, "reading_minutes": 0.5, "lead": "セガはゲーム「ファーミングシミュレーター25」の新しい有料DLC「Beans & Alpacas」を発売しました。南アメリカを舞台にした新しい農場で遊べます。", "lead_zh": "世嘉发布了游戏《模拟农场25》的新付费DLC“Beans & Alpacas”。玩家可以在以中南美洲为舞台的新农场里游玩。", "preview": "新しいエリアの名前は「Catuaí」です。ブラジルのコーヒー農園がある地方をイメージして作りました。赤い土と緑の多い谷で、川や細い道もあります。農場の近くには博物館や研究施設もあり、恐竜の骨を見ることもできます。", "preview_zh": "新区域名叫“Catuaí”，灵感来自巴西盛产咖啡的地方。这是一片红土、绿植繁茂的山谷，有河流和窄路。农场附近还有博物馆和研究设施，可以看到恐龙骨骼。", "has_audio": true, "audio": {"id": 790, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/81/ja_n4.mp3", "duration": 28.45, "size_bytes": 175104, "engine": "kokoro", "voice": "jf_alpha", "word_count": 98, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@dcbf67c/content/data/versions/807.json"}], "ja_n3": [{"content_hash": "9d75930c165d5af1", "version_id": 808, "article_id": 81, "level_code": "ja_n3", "lang": "ja", "level": 3, "level_label": "N3 中級", "title": "「Farming Simulator 25」に南米ステージの有料DLC「Beans & Alpacas」登場", "title_zh": "《模拟农场25》推出南美主题付费DLC「Beans & Alpacas」", "has_translation": true, "topic": "culture", "source": "gcores", "source_url": "https://www.gcores.com/articles/221607", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1612287230202-1ff1d85d1bdf?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MXx8ZGxjJTIwdmlkZW8lMjBnYW1lJTIwY29udHJvbGxlcnxlbnwwfDB8fHwxNzkzMjM2MjEzfDA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Javier Martínez on Unsplash", "author": "Javier Martínez", "credit_url": "https://unsplash.com/@cjdante?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/game-controller-in-neon-light-hUD0PUczwJQ?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(176, 42%, 62%)", "to": "hsl(214, 46%, 48%)", "label": "CULTURE", "seed": "5ab094f0a0ba"}}, "published_date": "2026-10-29", "word_count": 207, "reading_minutes": 0.6, "lead": "セガは「Farming Simulator 25」の有料DLC「Beans & Alpacas」を配信開始しました。南米を舞台にした新しい農場で、コーヒー栽培やアルパカの飼育が楽しめます。", "lead_zh": "世嘉已开始发售《模拟农场25》的付费DLC「Beans & Alpacas」。玩家可以在以南美为舞台的新农场里体验咖啡种植和羊驼饲养。", "preview": "DLCではブラジルのコーヒー農園をイメージした新しい地域「Catuaí」が追加されます。赤い土や緑の多い谷、曲がった道や川など、現地らしい景色が広がるので、農場を育てながら周辺を探検するのも楽しみの一つです。", "preview_zh": "DLC加入了以巴西咖啡种植园为灵感的新地区「Catuaí」。这里有红土、翠绿的山谷、蜿蜒的道路和河流，充满当地风情，玩家可以在经营农场的同时探索周边。", "has_audio": true, "audio": {"id": 791, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/81/ja_n3.mp3", "duration": 35.575, "size_bytes": 218592, "engine": "kokoro", "voice": "jf_alpha", "word_count": 124, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@dcbf67c/content/data/versions/808.json"}], "ja_n2": [{"content_hash": "e19a6bda63c6de97", "version_id": 809, "article_id": 81, "level_code": "ja_n2", "lang": "ja", "level": 4, "level_label": "N2 中高級", "title": "「Farming Simulator 25」に南米舞台の有料DLC「Beans & Alpacas」が登場", "title_zh": "《模拟农场25》推出南美主题付费DLC“Beans & Alpacas”", "has_translation": true, "topic": "culture", "source": "gcores", "source_url": "https://www.gcores.com/articles/221607", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1612287230202-1ff1d85d1bdf?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MXx8ZGxjJTIwdmlkZW8lMjBnYW1lJTIwY29udHJvbGxlcnxlbnwwfDB8fHwxNzkzMjM2MjEzfDA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Javier Martínez on Unsplash", "author": "Javier Martínez", "credit_url": "https://unsplash.com/@cjdante?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/game-controller-in-neon-light-hUD0PUczwJQ?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(176, 42%, 62%)", "to": "hsl(214, 46%, 48%)", "label": "CULTURE", "seed": "5ab094f0a0ba"}}, "published_date": "2026-10-29", "word_count": 262, "reading_minutes": 0.9, "lead": "セガは、農場経営シミュレーションゲーム「Farming Simulator 25」の有料DLC「Beans & Alpacas」を正式に配信開始した。南米を舞台にした新エリアや新作物、新動物が追加され、シリーズ初登場のブランドも含まれる。", "lead_zh": "世嘉正式发布了农场经营模拟游戏《模拟农场25》的付费DLC“Beans & Alpacas”。该DLC以南美为舞台，新增了区域、作物和动物，还包含系列首次登场的品牌。", "preview": "「Beans & Alpacas」は、ブラジルのコーヒー農園地帯をモデルにした新農場エリア「Catuaí（カトゥアイ）」を追加する。赤土や密林、なだらかな丘陵が広がる湿潤な谷で、狭い道路や川沿いの風景が特徴である。プレイヤーは農場経営の傍ら、博物館の恐竜の骨格標本や森林奥の研究施", "preview_zh": "“Beans & Alpacas”新增了以巴西咖啡种植区为原型的新农场区域“Catuaí”。这里是一片红土、密林和缓丘交织的湿润山谷，狭窄道路与河流沿岸的风景别具特色。玩家在经营农场之余，还可以参观博物馆的恐龙骨架标本或探访森林深处的研究设施，了解这片土地的故事。", "has_audio": true, "audio": {"id": 792, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/81/ja_n2.mp3", "duration": 51.25, "size_bytes": 312480, "engine": "kokoro", "voice": "jf_alpha", "word_count": 173, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@dcbf67c/content/data/versions/809.json"}], "ja_n1": [{"content_hash": "dbfa8ca671923502", "version_id": 810, "article_id": 81, "level_code": "ja_n1", "lang": "ja", "level": 5, "level_label": "N1 上級", "title": "セガ、「Farming Simulator 25」に南米舞台の有料DLC「Beans & Alpacas」を配信開始", "title_zh": "世嘉为《模拟农场25》推出南美主题付费DLC“Beans & Alpacas”", "has_translation": true, "topic": "culture", "source": "gcores", "source_url": "https://www.gcores.com/articles/221607", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1612287230202-1ff1d85d1bdf?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MXx8ZGxjJTIwdmlkZW8lMjBnYW1lJTIwY29udHJvbGxlcnxlbnwwfDB8fHw