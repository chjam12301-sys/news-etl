Hx8fDE3OTQyODIxOTB8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Badhan Ganesh on Unsplash", "author": "Badhan Ganesh", "credit_url": "https://unsplash.com/@badhanganesh?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/ace-of-spade-playing-card-wYFYDP9r8BY?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(28, 42%, 62%)", "to": "hsl(66, 46%, 48%)", "label": "LIFESTYLE", "seed": "5044abb86628"}}, "published_date": "2026-11-10", "word_count": 83, "reading_minutes": 0.3, "lead": "OnePlusは新しいスマホ「Ace 7」を出しました。中に小さなファンがあります。ゲームをする人向けのスマホです。", "lead_zh": "一加推出了新手机“Ace 7”。机身里装了小风扇。这是一款面向游戏玩家的手机。", "preview": "Ace 7は中にファンが二つあります。風の道も二つあります。これでスマホの熱を外に出します。", "preview_zh": "Ace 7机身内有两个风扇，还有两条风道，能把手机的热量排出去。", "has_audio": true, "audio": {"id": 910, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/93/ja_n5.mp3", "duration": 17.375, "size_bytes": 115056, "engine": "kokoro", "voice": "jf_alpha", "word_count": 61, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@8a18223/content/data/versions/926.json"}], "ja_n4": [{"content_hash": "1b76bceb10c94e70", "version_id": 927, "article_id": 93, "level_code": "ja_n4", "lang": "ja", "level": 2, "level_label": "N4 初級", "title": "OnePlus Ace 7、ファン内蔵でゲーム向けに登場", "title_zh": "一加 Ace 7 内置风扇，专为游戏玩家而来", "has_translation": true, "topic": "lifestyle", "source": "mydrivers_ev", "source_url": "https://news.mydrivers.com/1/1163/1163909.htm", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1600373633615-9b045feaa299?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8Mnx8cHJvJTIwYWNlJTIwbWFofGVufDB8MHx8fDE3OTQyODIxOTB8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Badhan Ganesh on Unsplash", "author": "Badhan Ganesh", "credit_url": "https://unsplash.com/@badhanganesh?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/ace-of-spade-playing-card-wYFYDP9r8BY?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(28, 42%, 62%)", "to": "hsl(66, 46%, 48%)", "label": "LIFESTYLE", "seed": "5044abb86628"}}, "published_date": "2026-11-10", "word_count": 150, "reading_minutes": 0.5, "lead": "OnePlusは新しいスマートフォン「Ace 7」を発表しました。中に冷却ファンを入れた、ゲームが好きな人向けの一台です。", "lead_zh": "一加发布了新手机 Ace 7。这台手机内置散热风扇，是专为游戏爱好者打造的产品。", "preview": "Ace 7の一番の特徴は、体の中に小さなファンがあることです。二つの風の道で熱を外に出します。長くゲームをしても、手机が熱くなりにくいです。", "preview_zh": "Ace 7 最大的特点，是机身里装了一个小风扇。它用两条风道把热量排出去。即使长时间玩游戏，手机也不容易发烫。", "has_audio": true, "audio": {"id": 911, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/93/ja_n4.mp3", "duration": 31.675, "size_bytes": 189504, "engine": "kokoro", "voice": "jf_alpha", "word_count": 106, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@8a18223/content/data/versions/927.json"}], "ja_n3": [{"content_hash": "6848598a3798615c", "version_id": 928, "article_id": 93, "level_code": "ja_n3", "lang": "ja", "level": 3, "level_label": "N3 中級", "title": "一加、ゲーム特化スマホ「Ace 7」発表　ファン内蔵で9000mAh電池", "title_zh": "一加发布游戏手机Ace 7：内置风扇加9000mAh电池", "has_translation": true, "topic": "lifestyle", "source": "mydrivers_ev", "source_url": "https://news.mydrivers.com/1/1163/1163909.htm", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1600373633615-9b045feaa299?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8Mnx8cHJvJTIwYWNlJTIwbWFofGVufDB8MHx8fDE3OTQyODIxOTB8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Badhan Ganesh on Unsplash", "author": "Badhan Ganesh", "credit_url": "https://unsplash.com/@badhanganesh?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/ace-of-spade-playing-card-wYFYDP9r8BY?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(28, 42%, 62%)", "to": "hsl(66, 46%, 48%)", "label": "LIFESTYLE", "seed": "5044abb86628"}}, "published_date": "2026-11-10", "word_count": 198, "reading_minutes": 0.6, "lead": "中国のスマートフォンメーカー一加は、ゲーム向けの新モデル「Ace 7」を発表しました。本体の中に冷却ファンを入れるなど、ゲームをよく遊ぶ人に向けた作りになっています。", "lead_zh": "中国手机厂商一加发布了面向游戏用户的新机型Ace 7。机身内置散热风扇等设计，专门为经常玩游戏的人打造。", "preview": "一加のAceシリーズは、これまでもゲームの性能を重視してきました。今回のAce 7では、本体の内部に小さなファンを初めて入れ、二つの風の通り道を作りました。これにより、スマホが熱くなりすぎるのを防ぎます。長時間ゲームをしても、手で持つ部分が暑くなりにくいのが特長です。", "preview_zh": "一加的Ace系列一直以来都重视游戏性能。这次的Ace 7首次在机身内部装入小风扇，并设计了两条风道。这样可以防止手机过热。即使长时间玩游戏，手握的部分也不容易变烫，这是一大特点。", "has_audio": true, "audio": {"id": 912, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/93/ja_n3.mp3", "duration": 35.25, "size_bytes": 211392, "engine": "kokoro", "voice": "jf_alpha", "word_count": 130, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@8a18223/content/data/versions/928.json"}], "ja_n2": [{"content_hash": "7d79241187283dee", "version_id": 929, "article_id": 93, "level_code": "ja_n2", "lang": "ja", "level": 4, "level_label": "N2 中高級", "title": "OnePlus Ace 7、ファン内蔵と9000mAh電池でゲーム特化を鮮明に", "title_zh": "一加Ace 7发布：内置风扇加9000mAh电池，主打游戏体验", "has_translation": true, "topic": "lifestyle", "source": "mydrivers_ev", "source_url": "https://news.mydrivers.com/1/1163/1163909.htm", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1600373633615-9b045feaa299?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8Mnx8cHJvJTIwYWNlJTIwbWFofGVufDB8MHx8fDE3OTQyODIxOTB8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Badhan Ganesh on Unsplash", "author": "Badhan Ganesh", "credit_url": "https://unsplash.com/@badhanganesh?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/ace-of-spade-playing-card-wYFYDP9r8BY?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(28, 42%, 62%)", "to": "hsl(66, 46%, 48%)", "label": "LIFESTYLE", "seed": "5044abb86628"}}, "published_date": "2026-11-10", "word_count": 274, "reading_minutes": 0.9, "lead": "OnePlusは新しいスマートフォン「OnePlus Ace 7」を発表した。標準モデルながら、本体内部に冷却ファンを搭載し、9000mAhの大容量電池を備えるなど、ゲーム利用を強く意識した構成が特徴である。", "lead_zh": "一加推出了新手机“一加Ace 7”。虽然是标准版，却在机身内部装了散热风扇，并配备9000mAh大电池，明显主打游戏用途。", "preview": "OnePlusのAceシリーズは、発売当初からゲーム性能の追求を中心に据えてきた。今回のAce 7では冷却方法を大きく変え、筐体の内部に小型ファンを組み込み、専用に設計した二系統の風路と組み合わせた「双路冰河風冷システム」を採用した。ファンが熱を積極的に外へ逃がす仕組みである。", "preview_zh": "一加的Ace系列从诞生起就以游戏性能为核心。这次的Ace 7大幅改变了散热方式，在机身内部装入小型风扇，并与专门设计的两条风道组合成“双路冰河风冷系统”，主动把热量排出。", "has_audio": true, "audio": {"id": 913, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/93/ja_n2.mp3", "duration": 58.15, "size_bytes": 348336, "engine": "kokoro", "voice": "jf_alpha", "word_count": 190, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@8a18223/content/data/versions/929.json"}], "ja_n1": [{"content_hash": "72e1dada55687ceb", "version_id": 930, "article_id": 93, "level_code": "ja_n1", "lang": "ja", "level": 5, "level_label": "N1 上級", "title": "OnePlus、Ace 7を発表　本体内蔵ファンと9000mAh電池でゲーマーに照準", "title_zh": "一加发布Ace 7：内置风扇加9000mAh电池，直击游戏玩家", "has_translation": true, "topic": "lifestyle", "source": "mydrivers_ev", "source_url": "https://news.mydrivers.com/1/1163/1163909.htm", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1600373633615-9b045feaa299?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8Mnx8cHJvJTIwYWNlJTIwbWFofGVufDB8MHx8fDE3OTQyODIxOTB8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Badhan Ganesh on Unsplash", "author": "Badhan Ganesh", "credit_url": "https://unsplash.com/@badhanganesh?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/ace-of-spade-playing-card-wYFYDP9r8BY?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(28, 42%, 62%)", "to": "hsl(66, 46%, 48%)", "label": "LIFESTYLE", "seed": "5044abb86628"}}, "published_date": "2026-11-10", "word_count": 334, "reading_minutes": 1.1, "lead": "OnePlusは新型スマートフォン「OnePlus Ace 7」を発表した。標準モデルながら、筐体内部に冷却ファンを組み込むという異例の設計を採用し、ゲーム性能の限界を押し広げる狙いである。", "lead_zh": "一加发布了新机OnePlus Ace 7。虽是标准版，却采用在机身内部装入散热风扇的罕见设计，意在突破游戏性能的边界。", "preview": "Aceシリーズは発足当初から、ゲーム性能を極限まで高めることだけを主眼としてきた。その最新世代となるAce 7で、OnePlusは冷却機構に踏み込んだ。本体内に能動型ファンを搭載し、専用設計の二系統の風路と組み合わせた「双路氷河風冷システム」を採用したのである。ファンが強制的に排", "preview_zh": "Ace系列自诞生起，就只专注于把游戏性能做到极致。到了最新一代Ace 7，一加在散热上更进一步：机身内置主动风扇，配合专门设计的两条风道，组成“双路冰河风冷系统”，靠风扇强制加速排热。", "has_audio": true, "audio": {"id": 906, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/93/ja_n1.mp3", "duration": 68.975, "size_bytes": 413712, "engine": "kokoro", "voice": "jf_alpha", "word_count": 230, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@8a18223/content/data/versions/930.json"}]}}}