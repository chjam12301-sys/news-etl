d_date": "2026-10-19", "word_count": 232, "reading_minutes": 1.2, "lead": "A Japanese spacecraft is set to launch on Monday and will try to collect dust from Phobos, one of Mars's two moons. If it succeeds, it will be the first sample ever brought back from Mars or its moons.", "lead_zh": "日本的一艘探测器将于周一发射，尝试从火星的两颗卫星之一——火卫一上采集尘埃。如果成功，这将是人类首次从火星或其卫星带回样本。", "preview": "The Mars Moons Exploration (MMX) mission is led by the Japanese Space Agency and will blast off from Japan. The spacecraft is expected to ar", "preview_zh": "火星卫星探测计划（MMX）由日本宇宙航空研究开发机构牵头，将从日本发射升空。探测器预计于2027年8月抵达火卫一。火卫一非常小，直径只有约20公里，形状有点像一颗太空土豆。太阳系内圈只有三颗卫星：我们的月球、火卫一和火卫二。", "has_audio": true, "audio": {"id": 695, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/71/en_b2.mp3", "duration": 82.45, "size_bytes": 495648, "engine": "kokoro", "voice": "af_heart", "word_count": 260, "has_timeline": true, "alternates": [{"voice": "af_bella", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/71/en_b2_af_bella.mp3", "duration": 84.0, "size_bytes": 505008, "engine": "kokoro", "word_count": 260, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/71/en_b2_af_bella.json"}, {"voice": "am_michael", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/71/en_b2_am_michael.mp3", "duration": 89.25, "size_bytes": 536400, "engine": "kokoro", "word_count": 260, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/71/en_b2_am_michael.json"}, {"voice": "bf_emma", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/71/en_b2_bf_emma.mp3", "duration": 77.025, "size_bytes": 463104, "engine": "kokoro", "word_count": 260, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/71/en_b2_bf_emma.json"}, {"voice": "bm_george", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/71/en_b2_bm_george.mp3", "duration": 82.5, "size_bytes": 495936, "engine": "kokoro", "word_count": 260, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/71/en_b2_bm_george.json"}]}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@521b5e9/content/data/versions/704.json"}], "en_c1": [{"content_hash": "c226794fcadb4708", "version_id": 705, "article_id": 71, "level_code": "en_c1", "lang": "en", "level": 5, "level_label": "C1 高级", "title": "Japan launches mission to bring back a piece of Mars's moon", "title_zh": "日本发射探测器，要去火星卫星上挖土带回地球", "has_translation": true, "topic": "science", "source": "bbc_science", "source_url": "https://www.bbc.co.uk/news/articles/cmvgxvkv54w1o?at_medium=RSS&at_campaign=rss", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1697689806591-e5e4269f10eb?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8OXx8bWlzc2lvbiUyMHNldCUyMGJsYXN0fGVufDB8MHx8fDE3OTIzNjYxMjd8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Behnam Mohsenzadeh on Unsplash", "author": "Behnam Mohsenzadeh", "credit_url": "https://unsplash.com/@bmohsenzadeh?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/a-bunch-of-smoke-is-billowing-out-of-a-building-Q5vwV1Xyor4?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(235, 42%, 62%)", "to": "hsl(273, 46%, 48%)", "label": "SCIENCE", "seed": "b923fc532535"}}, "published_date": "2026-10-19", "word_count": 342, "reading_minutes": 1.7, "lead": "A Japanese-led spacecraft is set to lift off on Monday, aiming to land on Phobos, one of Mars's two small moons, and return a sample to Earth. If successful, it would be the first material ever brought back from Mars or its moons for laboratory analysis.", "lead_zh": "由日本牵头的一艘探测器定于周一发射，目标是登陆火星两颗小卫星之一的火卫一，并把样本带回地球。如果成功，这将是人类首次从火星或其卫星带回可供实验室分析的物质。", "preview": "The Mars Moons Exploration mission, led by the Japanese space agency, i