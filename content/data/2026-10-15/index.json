ype": "photo", "url": "https://images.unsplash.com/photo-1527874594978-ee4f8a05b4c1?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MXx8YmFuayUyMGFtZXJpY2ElMjBmaW5lZHxlbnwwfDB8fHwxNzkyMDIyNTY4fDA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Melinda Gimpel on Unsplash", "author": "Melinda Gimpel", "credit_url": "https://unsplash.com/@melindagimpel?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/petition-to-file-for-bankruptcy-9j8k3l9afkc?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(122, 42%, 62%)", "to": "hsl(160, 46%, 48%)", "label": "BUSINESS", "seed": "04b2441ba82d"}}, "published_date": "2026-10-15", "word_count": 95, "reading_minutes": 0.3, "lead": "アメリカの 銀行が お金の ルールを 守らなかった。国は 大きな 罰金を 出した。", "lead_zh": "美国一家银行没有遵守资金规定，国家开出了巨额罚单。", "preview": "アメリカの 銀行に 1.2億ドルの 罰金が 出た。国は 「悪い お金を 見つけなかった」と 言った。", "preview_zh": "美国一家银行被罚12亿美元。国家说它“没有发现坏钱”。", "has_audio": true, "audio": {"id": 654, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/67/ja_n5.mp3", "duration": 17.95, "size_bytes": 111600, "engine": "kokoro", "voice": "jf_alpha", "word_count": 67, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@41106a7/content/data/versions/666.json"}], "ja_n4": [{"content_hash": "464a04729be1a709", "version_id": 667, "article_id": 67, "level_code": "ja_n4", "lang": "ja", "level": 2, "level_label": "N4 初級", "title": "バンク・オブ・アメリカに罰金1.2兆円", "title_zh": "美国银行被罚12亿美元", "has_translation": true, "topic": "business", "source": "guardian_business", "source_url": "https://www.theguardian.com/business/2026/oct/14/bank-of-america-fined-money-laundering", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1527874594978-ee4f8a05b4c1?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MXx8YmFuayUyMGFtZXJpY2ElMjBmaW5lZHxlbnwwfDB8fHwxNzkyMDIyNTY4fDA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Melinda Gimpel on Unsplash", "author": "Melinda Gimpel", "credit_url": "https://unsplash.com/@melindagimpel?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/petition-to-file-for-bankruptcy-9j8k3l9afkc?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(122, 42%, 62%)", "to": "hsl(160, 46%, 48%)", "label": "BUSINESS", "seed": "04b2441ba82d"}}, "published_date": "2026-10-15", "word_count": 162, "reading_minutes": 0.5, "lead": "アメリカの銀行、バンク・オブ・アメリカは、お金を洗うのを防ぐ仕事が足りないと言われました。そのため、アメリカ政府は大きな罰金を出しました。", "lead_zh": "美国银行因为反洗钱工作不到位，被美国政府处以巨额罚款。", "preview": "アメリカの財務省は、バンク・オブ・アメリカに1.21億ドルの罰金を出しました。これは財務省の歴史で3番目に大きな罰金です。銀行が50億ドル以上のあやしいお金の動きを政府に知らせなかったからです。", "preview_zh": "美国财政部对美国银行处以12.1亿美元罚款，这是财政部历史上第三大罚款。原因是银行没有向政府报告超过50亿美元的可疑资金流动。", "has_audio": true, "audio": {"id": 655, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/67/ja_n4.mp3", "duration": 28.725, "size_bytes": 175824, "engine": "kokoro", "voice": "jf_alpha", "word_count": 101, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@41106a7/content/data/versions/667.json"}], "ja_n3": [{"content_hash": "cdd67c6ee258ba22", "version_id": 668, "article_id": 67, "level_code": "ja_n3", "lang": "ja", "level": 3, "level_label": "N3 中級", "title": "バンク・オブ・アメリカ、マネーロンダリング対策の失敗で1200億円の罰金", "title_zh": "美国银行因反洗钱失败被罚12亿美元", "has_translation": true, "topic": "business", "source": "guardian_business", "source_url": "https://www.theguardian.com/business/2026/oct/14/bank-of-america-fined-money-laundering", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1527874594978-ee4f8a05b4c1?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MXx8YmFuayUyMGFtZXJpY2ElMjBmaW5lZHxlbnwwfDB8fHwxNzkyMDIyNTY4fDA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Melinda Gimpel on Unsplash", "author": "Melinda Gimpel", "credit_url": "https://unsplash.com/@melindagimpel?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/petition-to-file-for-bankruptcy-9j8k3l9afkc?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(122, 42%, 62%)", "to": "hsl(160, 46%, 48%)", "label": "BUSINESS", "seed": "04b2441ba82d"}}, "published_date": "2026-10-15", "word_count": 211, "reading_minutes": 0.6, "lead": "アメリカの規制当局は、バンク・オブ・アメリカに約1.21億ドルの罰金を科しました。疑わしい取引を報告しなかったからです。この罰金は銀行の利益に影響を与えるでしょう。", "lead_zh": "美国监管机构对美国银行处以约12.1亿美元罚款，原因是该行未报告可疑交易。这笔罚款将影响银行的利润。", "preview": "アメリカ財務省は、バンク・オブ・アメリカが50億ドル以上の疑わしい活動を報告しなかったので、1.21億ドルの罰金を科しました。これは財務省の歴史で3番目に大きい罰金です。財務長官のスコット・ベッセント氏は「銀行が義務を果たさないと、アメリカの金融システム全体が危険にさらされる」と", "preview_zh": "美国财政部表示，由于美国银行未报告超过50亿美元的可疑活动，对其处以12.1亿美元罚款。这是财政部历史上第三大罚款。财政部长斯科特·贝森特表示：“如果银行不履行义务，整个美国金融体系将面临风险。”", "has_audio": true, "audio": {"id": 656, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/67/ja_n3.mp3", "duration": 23.4, "size_bytes": 221328, "engine": "kokoro", "voice": "jf_alpha", "word_count": 71, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@41106a7/content/data/versions/668.json"}], "ja_n2": [{"content_hash": "b37fd217d0666d22", "version_id": 669, "article_id": 67, "level_code": "ja_n2", "lang": "ja", "level": 4, "level_label": "N2 中高級", "title": "バンク・オブ・アメリカ、マネーロンダリング対策の不備で12億ドル超の制裁金", "title_zh": "美国银行因反洗钱不力被罚12亿美元", "has_translation": true, "topic": "business", "source": "guardian_business", "source_url": "https://www.theguardian.com/business/2026/oct/14/bank-of-america-fined-money-laundering", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1527874594978-ee4f8a05b4c1?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MXx8YmFuayUyMGFtZXJpY2ElMjBmaW5lZHxlbnwwfDB8fHwxNzkyMDIyNTY4fDA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Melinda Gimpel on Unsplash", "author": "Melinda Gimpel", "credit_url": "https://unsplash.com/@melindagimpel?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/petition-to-file-for-bankruptcy-9j8k3l9afkc?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(122, 42%, 62%)", "to": "hsl(160, 46%, 48%)", "label": "BUSINESS", "seed": "04b2441ba82d"}}, "published_date": "2026-10-15", "word_count": 270, "reading_minutes": 0.8, "lead": "アメリカの金融大手バンク・オブ・アメリカは、疑わしい取引の報告を怠ったとして、アメリカの規制当局から12億1000万ドルの制裁金を科されました。同行は、この罰金が第3四半期の利益を押し下げると述べています。", "lead_zh": "美国金融巨头美国银行因未报告可疑交易，被美国监管机构处以12.1亿美元罚款。该行表示，这笔罚款将拉低第三季度利润。", "preview": "アメリカ財務省によると、この制裁金は同省の歴史で3番目に大きく、同行が50億ドルを超える疑わしい活動を政府に報告しなかったことが理由です。その中には、国家安全保障に関わるリスクがあるとされた10億ドルも含まれます。財務省のスコット・ベッセント長官は声明で、「この規模の銀行がマネー", "preview_zh": "美国财政部表示，这笔罚款是该部历史上第三大罚款，原因是该行未向政府报告超过50亿美元的可疑活动，其中10亿美元被认为涉及国家安全风险。财政部长斯科特·贝森特在声明中说：“像这样规模的银行如果未能履行反洗钱和制裁义务，后果将远超该行自身，使整个美国金融体系面临重大非法金融风险。”", "has_audio": true, "audio": {"id": 657, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/67/ja_n2.mp3", "duration": 49.2, "size_bytes": 294624, "engine": "kokoro", "voice": "jf_alpha", "word_count": 168, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@41106a7/content/data/versions/669.json"}], "ja_n1": [{"content_hash": "512e3e947f57d8ef", "version_id": 670, "article_id": 67, "level_code": "ja_n1", "lang": "ja", "level": 5, "level_label": "N1 上級", "title": "米銀バンク・オブ・アメリカ、マネーロンダリング対策の不備で1200億円超の制裁金", "title_zh": "美国银行因反洗钱漏洞被罚12亿美元", "has_translation": true, "topic": "business", "source": "guardian_business", "source_url": "https://www.theguardian.com/business/2026/oct/14/bank-of-america-fined-money-laundering", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1527874594978-ee4f8a05b4c1?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MXx8YmFuayUyMGFtZXJpY2ElMjBmaW5lZHxlbnwwfDB8fHwxNzkyMDIyNTY4fDA&ixlib=rb-4.1.0&w=1600&q=75&f