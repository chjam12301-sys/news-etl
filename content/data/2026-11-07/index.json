ider": "unsplash", "credit": "Photo by Catarina Duarte on Unsplash", "author": "Catarina Duarte", "credit_url": "https://unsplash.com/@cateduart?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/the-van-gogh-museum-building-with-a-green-lawn-ynFz9p5YcBE?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(299, 42%, 62%)", "to": "hsl(337, 46%, 48%)", "label": "LIFESTYLE", "seed": "b52bc96122d4"}}, "published_date": "2026-11-07", "word_count": 276, "reading_minutes": 0.9, "lead": "英国老牌百货公司ジョン・ルイスが11月3日、今年のクリスマス広告「Gloria and Pickles」を公開した。祖母と孫の交流を通じて、贈り物に込める気持ちの価値を問いかける内容である。", "lead_zh": "英国老牌百货 John Lewis 于11月3日发布今年圣诞广告《Gloria and Pickles》，通过祖母与孙辈的互动，重新探讨送礼心意的价值。", "preview": "広告の主人公は、クリスマスを前に孫たちを迎える準備をする祖母グロリアである。彼女は子どもの頃に遊んだ、ピクルスという名前の犬のおもちゃを引っ張り出して孫を喜ばせようとするが、スマートフォンに夢中な子どもたちの反応は冷たい。落ち込んだグロリアは現金を渡そうと考えるが、ピクルスに励ま", "preview_zh": "广告主角是赶在圣诞节前迎接孙辈的祖母格洛丽亚。她翻出小时候玩过的拉绳小狗玩具“皮克尔斯”，想讨孙辈开心，但沉迷手机的孩子们反应冷淡。失落的格洛丽亚本想直接给钱，却在皮克尔斯的鼓励下，最后在家里搭起一个“秘密基地”，和孙辈一起玩耍。", "has_audio": true, "audio": {"id": 882, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/90/ja_n2.mp3", "duration": 53.4, "size_bytes": 319824, "engine": "kokoro", "voice": "jf_alpha", "word_count": 163, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@feabd64/content/data/versions/899.json"}], "ja_n1": [{"content_hash": "ff25f50018ea5e16", "version_id": 900, "article_id": 90, "level_code": "ja_n1", "lang": "ja", "level": 5, "level_label": "N1 上級", "title": "John Lewisが2026年クリスマス広告を公開、「心を込めた贈り物を諦めないで」と訴え", "title_zh": "John Lewis发布2026圣诞广告，呼吁大家“别放弃用心送礼”", "has_translation": true, "topic": "lifestyle", "source": "toodaylab", "source_url": "https://www.toodaylab.com/84280", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1784210156339-43fceaca3548?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8M3x8am9obiUyMGxld2lzfGVufDB8MHx8fDE3OTQwMTMzNjd8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Catarina Duarte on Unsplash", "author": "Catarina Duarte", "credit_url": "https://unsplash.com/@cateduart?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/the-van-gogh-museum-building-with-a-green-lawn-ynFz9p5YcBE?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(299, 42%, 62%)", "to": "hsl(337, 46%, 48%)", "label": "LIFESTYLE", "seed": "b52bc96122d4"}}, "published_date": "2026-11-07", "word_count": 236, "reading_minutes": 1.1, "lead": "英百貨店John Lewisが11月3日、今年のクリスマス広告「Gloria and Pickles」を公開した。祖母と孫の物語を通じ、画面に奪われがちな現代において、心を込めて贈り物を選ぶことの価値を問いかけている。", "lead_zh": "英国百货公司John Lewis于11月3日发布今年的圣诞广告《Gloria and Pickles》。广告借祖母与孙辈的故事，在注意力容易被屏幕夺走的当下，追问用心挑选礼物的价值。", "preview": "広告の主人公は、クリスマスを前に孫たちを迎える祖母Gloria。幼い頃の玩具で孫を喜ばせようと、犬の引き車「Pickles」を引っ張り出すが、子どもたちは見向きもしない。金銭を渡すしかないかと諦めかけたGloriaを、Picklesが励まし、最後には家中を「秘密基地」に仕立て上げ", "preview_zh": "广告主角是圣诞节前迎接孙辈的祖母Gloria。她想用儿时的玩具逗孙辈开心，翻出了名叫Pickles的拖拉小狗玩具，孩子们却毫无兴趣。就在Gloria打算干脆给钱时，Pickles鼓励她不要放弃，最终她把家里布置成“秘密基地”，与孙辈共同留下玩耍的节日记忆。", "has_audio": true, "audio": {"id": 883, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/90/ja_n1.mp3", "duration": 75.05, "size_bytes": 450144, "engine": "kokoro", "voice": "jf_alpha", "word_count": 174, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@feabd64/content/data/versions/900.json"}]}}}