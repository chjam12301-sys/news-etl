_bytes": 351792, "engine": "kokoro", "word_count": 192, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/99/en_a2_af_bella.json"}, {"voice": "am_michael", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/99/en_a2_am_michael.mp3", "duration": 64.125, "size_bytes": 385776, "engine": "kokoro", "word_count": 192, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/99/en_a2_am_michael.json"}, {"voice": "bf_emma", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/99/en_a2_bf_emma.mp3", "duration": 55.7, "size_bytes": 335088, "engine": "kokoro", "word_count": 192, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/99/en_a2_bf_emma.json"}, {"voice": "bm_george", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/99/en_a2_bm_george.mp3", "duration": 59.025, "size_bytes": 355104, "engine": "kokoro", "word_count": 192, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/99/en_a2_bm_george.json"}]}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@8c427cb2/content/data/versions/982.json", "paragraphs": ["Tech site PC Mag shared a new survey this week. It found that 8% of adult gamers in the US plan to take paid leave on November 19. That is the day GTA 6 comes out. About 12.5 million people want free time to play it.", "Young players are the most excited. 13% of Gen Z gamers said they will change their plans for the game. GTA 6 only works on new consoles, so 7% of players plan to buy new hardware. Another 3% will take two days off or more.", "Not everyone is in a hurry. 68% of people in the survey said they will not play the game on day one. PC Mag asked YouGov to run the survey. It covered 2,024 adults online from October 23 to 27, 2026.", "The survey also asked how people will find time. 14% will use their normal free time. 4% will use evenings and weekends. 2% will take half a day off or change their work hours."], "paragraphs_zh": ["科技媒体 PC Mag 本周公布了一项新调查。调查发现，8% 的美国成年玩家打算在 11 月 19 日请带薪假。那天正是《GTA6》发售的日子。约 1250 万人想腾出时间来玩这款游戏。", "年轻玩家最兴奋。13% 的 Z 世代玩家表示会为这款游戏调整安排。《GTA6》只能在最新主机上运行，所以 7% 的玩家打算买新设备。另有 3% 的人会请两天或更长时间的假。", "也不是所有人都着急。调查中 68% 的人说不会在发售第一天就玩。PC Mag 委托 YouGov 做这次调查。调查在 2026 年 10 月 23 日至 27 日以线上问卷方式进行，共覆盖 2024 名成年人。", "调查还问了大家怎么挤出时间。14% 的人会用平时的空闲时间。4% 的人会用晚上和周末。2% 的人会请半天假或调整工作时间。"], "body": "Tech site PC Mag shared a new survey this week. It found that 8% of adult gamers in the US plan to take paid leave on November 19. That is the day GTA 6 comes out. About 12.5 million people want free time to play it.\n\nYoung players are the most excited. 13% of Gen Z gamers said they will change their plans for the game. GTA 6 only works on new consoles, so 7% of players plan to buy new hardware. Another 3% will take two days off or more.\n\nNot everyone is in a hurry. 68% of people in the survey said they will not play the game on day one. PC Mag asked YouGov to run the survey. It covered 2,024 adults online from October 23 to 27, 2026.\n\nThe survey also asked how people will find time. 14% will use their normal free time. 4% will use evenings and weekends. 2% will take half a day off or change their work hours.", "body_zh": "科技媒体 PC Mag 本周公布了一项新调查。调查发现，8% 的美国成年玩家打算在 11 月 19 日请带薪假。那天正是《GTA6》发售的日子。约 1250 万人想腾出时间来玩这款游戏。\n\n年轻玩家最兴奋。13% 的 Z 世代玩家表示会为这款游戏调整安排。《GTA6》只能在最新主机上运行，所以 7% 的玩家打算买新设备。另有 3% 的人会请两天或更长时间的假。\n\n也不是所有人都着急。调查中 68% 的人说不会在发售第一天就玩。PC Mag 委托 YouGov 做这次调查。调查在 2026 年 10 月 23 日至 27 日以线上问卷方式进行，共覆盖 2024 名成年人。\n\n调查还问了大家怎么挤出时间。14% 的人会用平时的空闲时间。4% 的人会用晚上和周末。2% 的人会请半天假或调整工作时间。", "text": "Tech site PC Mag shared a new survey this week. It found that 8% of adult gamers in the US plan to take paid leave on November 19. That is the day GTA 6 comes out. About 12.5 million people want free time to play it. Young players are the most excited. 13% of Gen Z gamers said they will change their plans for the game. GTA 6 only works on new consoles, so 7% of players plan to buy new hardware. Another 3% will take two days off or more. Not everyone is in a hurry. 68% of people in the survey said they will not play the game on day one. PC Mag asked YouGov to run the survey. It covered 2,024 adults online from October 23 to 27, 2026. The survey also asked how people will find time. 14% will use their normal free time. 4% will use evenings and weekends. 2% will take half a day off or change their work hours.", "vocab": [{"word": "survey", "pos": "noun", "zh": "调查", "note": "常见搭配：a new survey shows...", "phonetic": "", "en": ""}, {"word": "plan to", "pos": "phrase", "zh": "计划做某事", "note": "后接动词原形", "phonetic": "", "en": ""}, {"word": "paid leave", "pos": "phrase", "zh": "带薪假", "note": "take paid leave 请带薪假", "phonetic": "", "en": ""}, {"word": "take time off", "pos": "phrase", "zh": "请假、腾出时间", "note": "off 表示不上班", "phonetic": "", "en": ""}, {"word": "console", "pos": "noun", "zh": "游戏主机", "note": "如 PlayStation、Xbox", "phonetic": "", "en": ""}, {"word": "excited", "pos": "adj", "zh": "兴奋的", "note": "be excited about sth", "phonetic": "", "en": ""}, {"word": "hardware", "pos": "noun", "zh": "硬件、设备", "note": "这里指游戏机", "phonetic": "", "en": ""}, {"word": "in a hurry", "pos": "phrase", "zh": "着急、赶时间", "note": "否定句里表示不着急", "phonetic": "", "en": ""}], "fetched_at": "2026-11-16T01:16:24.797609", "timeline": [{"i": 0, "w": "Tech", "s": 0.275, "e": 0.5, "sm": 275, "em": 500, "cs": 0, "ce": 4, "si": 0}, {"i": 1, "w": "site", "s": 0.5, "e": 0.725, "sm": 500, "em": 725, "cs": 5, "ce": 9, "si": 0}, {"i": 2, "w": "PC", "s": 0.725, "e": 1.125, "sm": 725, "em": 1125, "cs": 10, "ce": 12, "si": 0}, {"i": 3, "w": "Mag", "s": 1.125, "e": 1.512, "sm": 1125, "em": 1512, "cs": 13, "ce": 16, "si": 0}, {"i": 4, "w": "shared", "s": 1.512, "e": 1.762, "sm": 1512, "em": 1762, "cs": 17, "ce": 23, "si": 0}, {"i": 5, "w": "a", "s": 1.762, "e": 1.837, "sm": 1762, "em": 1837, "cs": 24, "ce": 25, 