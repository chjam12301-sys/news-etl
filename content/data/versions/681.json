/pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/69/en_a1_af_bella.mp3", "duration": 30.55, "size_bytes": 184320, "engine": "kokoro", "word_count": 111, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/69/en_a1_af_bella.json"}, {"voice": "am_michael", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/69/en_a1_am_michael.mp3", "duration": 32.95, "size_bytes": 198720, "engine": "kokoro", "word_count": 111, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/69/en_a1_am_michael.json"}, {"voice": "bf_emma", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/69/en_a1_bf_emma.mp3", "duration": 28.825, "size_bytes": 173952, "engine": "kokoro", "word_count": 111, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/69/en_a1_bf_emma.json"}, {"voice": "bm_george", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/69/en_a1_bm_george.mp3", "duration": 30.8, "size_bytes": 185760, "engine": "kokoro", "word_count": 111, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/69/en_a1_bm_george.json"}]}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@dcbf67c/content/data/versions/681.json", "paragraphs": ["Joshua Foster is 37 years old. He comes from Essex in England. He took his family to a hotel in Cyprus on 12 July.", "Foster put his son on a window sill. He wanted to show the boy a waterpark. He thought the window was closed.", "The window was open. The boy fell about 40 feet. He died at the hospital later. Foster said he lost control of his son.", "A court said Foster caused his son's death. The judge said it was a mistake. Foster must pay €3,000. He said he wants to go home."], "paragraphs_zh": ["乔舒亚·福斯特37岁，来自英格兰埃塞克斯。7月12日，他带家人住进塞浦路斯的一家酒店。", "福斯特把儿子放在窗台上。他想让儿子看水上乐园。他以为窗户是关着的。", "窗户是开着的。男孩从约40英尺高处坠落。他后来在医院去世。福斯特说他没抓住儿子。", "法院说福斯特导致儿子死亡。法官说这是一个失误。福斯特必须支付3000欧元。他说他想回家。"], "body": "Joshua Foster is 37 years old. He comes from Essex in England. He took his family to a hotel in Cyprus on 12 July.\n\nFoster put his son on a window sill. He wanted to show the boy a waterpark. He thought the window was closed.\n\nThe window was open. The boy fell about 40 feet. He died at the hospital later. Foster said he lost control of his son.\n\nA court said Foster caused his son's death. The judge said it was a mistake. Foster must pay €3,000. He said he wants to go home.", "body_zh": "乔舒亚·福斯特37岁，来自英格兰埃塞克斯。7月12日，他带家人住进塞浦路斯的一家酒店。\n\n福斯特把儿子放在窗台上。他想让儿子看水上乐园。他以为窗户是关着的。\n\n窗户是开着的。男孩从约40英尺高处坠落。他后来在医院去世。福斯特说他没抓住儿子。\n\n法院说福斯特导致儿子死亡。法官说这是一个失误。福斯特必须支付3000欧元。他说他想回家。", "text": "Joshua Foster is 37 years old. He comes from Essex in England. He took his family to a hotel in Cyprus on 12 July. Foster put his son on a window sill. He wanted to show the boy a waterpark. He thought the window was closed. The window was open. The boy fell about 40 feet. He died at the hospital later. Foster said he lost control of his son. A court said Foster caused his son's death. The judge said it was a mistake. Foster must pay €3,000. He said he wants to go home.", "vocab": [{"word": "father", "pos": "noun", "zh": "父亲", "note": "dad 更口语", "phonetic": "", "en": ""}, {"word": "son", "pos": "noun", "zh": "儿子", "note": "", "phonetic": "", "en": ""}, {"word": "hotel", "pos": "noun", "zh": "酒店", "note": "", "phonetic": "", "en": ""}, {"word": "window", "pos": "noun", "zh": "窗户", "note": "", "phonetic": "", "en": ""}, {"word": "fall", "pos": "verb", "zh": "坠落", "note": "过去式 fell", "phonetic": "", "en": ""}, {"word": "die", "pos": "verb", "zh": "死亡", "note": "过去式 died", "phonetic": "", "en": ""}, {"word": "fine", "pos": "verb", "zh": "罚款", "note": "名词也是罚款", "phonetic": "", "en": ""}, {"word": "court", "pos": "noun", "zh": "法院", "note": "", "phonetic": "", "en": ""}], "fetched_at": "2026-10-16T23:48:02.449828", "timeline": [{"i": 0, "w": "Jos