_bytes": 208800, "engine": "kokoro", "word_count": 104, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/103/en_a1_af_bella.json"}, {"voice": "am_michael", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/103/en_a1_am_michael.mp3", "duration": 36.9, "size_bytes": 222336, "engine": "kokoro", "word_count": 104, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/103/en_a1_am_michael.json"}, {"voice": "bf_emma", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/103/en_a1_bf_emma.mp3", "duration": 32.2, "size_bytes": 194112, "engine": "kokoro", "word_count": 104, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/103/en_a1_bf_emma.json"}, {"voice": "bm_george", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/103/en_a1_bm_george.mp3", "duration": 34.475, "size_bytes": 207792, "engine": "kokoro", "word_count": 104, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/103/en_a1_bm_george.json"}]}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@a9d358e2/content/data/versions/1021.json", "paragraphs": ["Anthropic sold shares on the Nasdaq under the name ANT. It raised about 81 billion dollars. This is the largest IPO in history.", "Seven big tech companies, including Nvidia and Microsoft, bought more shares. Anthropic expects to get about 105 billion dollars in total.", "On the same day, almost 100 AI experts and scientists signed a public letter. They said Anthropic is not a safe AI company.", "The signers usually disagree with each other. Now they agree on one thing. They do not want Anthropic to control the future of AI."], "paragraphs_zh": ["Anthropic以“ANT”为代码在纳斯达克出售股票，筹集了约810亿美元。这是史上规模最大的IPO。", "英伟达、微软等七家科技巨头额外认购了股票。Anthropic预计总共可获得约1050亿美元。", "同一天，近百位AI专家和科学家签署了一封公开信。他们说Anthropic不是一家安全的AI公司。", "这些签署者平时意见不合，现在他们在一件事上达成一致：他们不想让Anthropic掌控AI的未来。"], "body": "Anthropic sold shares on the Nasdaq under the name ANT. It raised about 81 billion dollars. This is the largest IPO in history.\n\nSeven big tech companies, including Nvidia and Microsoft, bought more shares. Anthropic expects to get about 105 billion dollars in total.\n\nOn the same day, almost 100 AI experts and scientists signed a public letter. They said Anthropic is not a safe AI company.\n\nThe signers usually disagree with each other. Now they agree on one thing. They do not want Anthropic to control the future of AI.", "body_zh": "Anthropic以“ANT”为代码在纳斯达克出售股票，筹集了约810亿美元。这是史上规模最大的IPO。\n\n英伟达、微软等七家科技巨头额外认购了股票。Anthropic预计总共可获得约1050亿美元。\n\n同一天，近百位AI专家和科学家签署了一封公开信。他们说Anthropic不是一家安全的AI公司。\n\n这些签署者平时意见不合，现在他们在一件事上达成一致：他们不想让Anthropic掌控AI的未来。", "text": "Anthropic sold shares on the Nasdaq under the name ANT. It raised about 81 billion dollars. This is the largest IPO in history. Seven big tech companies, including Nvidia and Microsoft, bought more shares. Anthropic expects to get about 105 billion dollars in total. On the same day, almost 100 AI experts and scientists signed a public letter. They said Anthropic is not a safe AI company. The signers usually disagree with each other. Now they agree on one thing. They do not want Anthropic to control the future of AI.", "vocab": [{"word": "share", "pos": "noun", "zh": "股票；股份", "note": "公司股票的一份", "phonetic": "", "en": ""}, {"word": "company", "pos": "noun", "zh": "公司", "note": "", "phonetic": "", "en": ""}, {"word": "raise", "pos": "verb", "zh": "筹集（资金）", "note": "raise money 筹钱", "phonetic": "", "en": ""}, {"word": "record", "pos": "noun", "zh": "纪录", "note": "", "phonetic": "", "en": ""}, {"word": "expert", "pos": "noun", "zh": "专家", "note": "", "phonetic": "", "en": ""}, {"word": "sign", "pos": "verb", "zh": "签署", "note": "sign a letter 签署信件", "phonetic": "", "en": ""}, {"word": "safe", "pos": "adj", "zh": "安全的", "note": "", "phonetic": "", "en": ""}, {"word": "agree", "