.8, "size_bytes": 239760, "engine": "kokoro", "word_count": 109, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/88/en_a1_af_bella.json"}, {"voice": "am_michael", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/88/en_a1_am_michael.mp3", "duration": 42.3, "size_bytes": 254736, "engine": "kokoro", "word_count": 109, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/88/en_a1_am_michael.json"}, {"voice": "bf_emma", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/88/en_a1_bf_emma.mp3", "duration": 36.725, "size_bytes": 221328, "engine": "kokoro", "word_count": 109, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/88/en_a1_bf_emma.json"}, {"voice": "bm_george", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/88/en_a1_bm_george.mp3", "duration": 39.15, "size_bytes": 235872, "engine": "kokoro", "word_count": 109, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/88/en_a1_bm_george.json"}]}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@959f3ce/content/data/versions/871.json", "paragraphs": ["Storage Hunter Simulator comes to PlayStation 5 and Xbox Series X|S on November 24, 2026. It costs $24.99. Players bid on garages, storage rooms and containers.", "The game has thousands of items. Players can ask experts to check prices. They can also open a pawn shop and hire workers.", "Up to four friends can play together. They share one bank account. A bigger version, No Refunds Edition, costs $34.99.", "The game is already on PC. It has an easy mode and a hard mode. Players can drive seven vehicles."], "paragraphs_zh": ["《仓库猎人模拟器》将于2026年11月24日登陆PlayStation 5和Xbox Series X|S，售价24.99美元。玩家可以竞拍车库、储物间和集装箱。", "游戏里有数千种物品。玩家可以请专家鉴定价格，也可以开典当行、雇员工。", "最多四位好友可以一起玩，共用一个银行账户。更大的《概不退款版》售价34.99美元。", "这款游戏已在PC平台推出。游戏有轻松和困难两种模式，玩家还能驾驶七种载具。"], "body": "Storage Hunter Simulator comes to PlayStation 5 and Xbox Series X|S on November 24, 2026. It costs $24.99. Players bid on garages, storage rooms and containers.\n\nThe game has thousands of items. Players can ask experts to check prices. They can also open a pawn shop and hire workers.\n\nUp to four friends can play together. They share one bank account. A bigger version, No Refunds Edition, costs $34.99.\n\nThe game is already on PC. It has an easy mode and a hard mode. Players can drive seven vehicles.", "body_zh": "《仓库猎人模拟器》将于2026年11月24日登陆PlayStation 5和Xbox Series X|S，售价24.99美元。玩家可以竞拍车库、储物间和集装箱。\n\n游戏里有数千种物品。玩家可以请专家鉴定价格，也可以开典当行、雇员工。\n\n最多四位好友可以一起玩，共用一个银行账户。更大的《概不退款版》售价34.99美元。\n\n这款游戏已在PC平台推出。游戏有轻松和困难两种模式，玩家还能驾驶七种载具。", "text": "Storage Hunter Simulator comes to PlayStation 5 and Xbox Series X|S on November 24, 2026. It costs $24.99. Players bid on garages, storage rooms and containers. The game has thousands of items. Players can ask experts to check prices. They can also open a pawn shop and hire workers. Up to four friends can play together. They share one bank account. A bigger version, No Refunds Edition, costs $34.99. The game is already on PC. It has an easy mode and a hard mode. Players can drive seven vehicles.", "vocab": [{"word": "game", "pos": "noun", "zh": "游戏", "note": "", "phonetic": "", "en": ""}, {"word": "cost", "pos": "verb", "zh": "花费；售价为", "note": "cost 的过去式仍是 cost", "phonetic": "", "en": ""}, {"word": "player", "pos": "noun", "zh": "玩家", "note": "", "phonetic": "", "en": ""}, {"word": "buy", "pos": "verb", "zh": "购买", "note": "", "phonetic": "", "en": ""}, {"word": "friend", "pos": "noun", "zh": "朋友", "note": "", "phonetic": "", "en": ""}, {"word": "together", "pos": "adv", "zh": "一起", "note": "", "phonetic": "", "en": ""}, {"word": "expert", "pos": "noun", "zh": "专家", "note": "", "phonetic": "", "en": ""}, {"word": "drive", "pos": "verb", "zh": "驾驶", "note": "", "phonetic": "", "en": ""}], "fetched_at": "2026-11-05