e_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/83/en_a1_af_bella.json"}, {"voice": "am_michael", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/83/en_a1_am_michael.mp3", "duration": 34.575, "size_bytes": 208368, "engine": "kokoro", "word_count": 104, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/83/en_a1_am_michael.json"}, {"voice": "bf_emma", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/83/en_a1_bf_emma.mp3", "duration": 29.2, "size_bytes": 176112, "engine": "kokoro", "word_count": 104, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/83/en_a1_bf_emma.json"}, {"voice": "bm_george", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/83/en_a1_bm_george.mp3", "duration": 30.975, "size_bytes": 186768, "engine": "kokoro", "word_count": 104, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/83/en_a1_bm_george.json"}]}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@91b304e/content/data/versions/821.json", "paragraphs": ["The phones come in four colors. One is blue and one is orange. The screens are fast and good for games.", "The Ace 7 Pro has a strong new chip. The Ace 7 has a similar chip. Both phones stay cool when you play games.", "Both phones have a 200 megapixel camera. The Ace 7 Pro also has a long zoom lens. The battery is 9000mAh and charges at 100W.", "The Ace 7 Pro starts at 3649 yuan. The Ace 7 starts at 3249 yuan. You can buy them soon."], "paragraphs_zh": ["这两款手机有四种颜色，一款是蓝色，一款是橙色。屏幕很快，适合打游戏。", "Ace 7 Pro用新的强芯片，Ace 7用相似的芯片。两款手机打游戏时都不容易发热。", "两款手机都有2亿像素摄像头。Ace 7 Pro还有长焦镜头。电池是9000mAh，支持100W充电。", "Ace 7 Pro售价3649元起，Ace 7售价3249元起。很快就能买到。"], "body": "The phones come in four colors. One is blue and one is orange. The screens are fast and good for games.\n\nThe Ace 7 Pro has a strong new chip. The Ace 7 has a similar chip. Both phones stay cool when you play games.\n\nBoth phones have a 200 megapixel camera. The Ace 7 Pro also has a long zoom lens. The battery is 9000mAh and charges at 100W.\n\nThe Ace 7 Pro starts at 3649 yuan. The Ace 7 starts at 3249 yuan. You can buy them soon.", "body_zh": "这两款手机有四种颜色，一款是蓝色，一款是橙色。屏幕很快，适合打游戏。\n\nAce 7 Pro用新的强芯片，Ace 7用相似的芯片。两款手机打游戏时都不容易发热。\n\n两款手机都有2亿像素摄像头。Ace 7 Pro还有长焦镜头。电池是9000mAh，支持100W充电。\n\nAce 7 Pro售价3649元起，Ace 7售价3249元起。很快就能买到。", "text": "The phones come in four colors. One is blue and one is orange. The screens are fast and good for games. The Ace 7 Pro has a strong new chip. The Ace 7 has a similar chip. Both phones stay cool when you play games. Both phones have a 200 megapixel camera. The Ace 7 Pro also has a long zoom lens. The battery is 9000mAh and charges at 100W. The Ace 7 Pro starts at 3649 yuan. The Ace 7 starts at 3249 yuan. You can buy them soon.", "vocab": [{"word": "launch", "pos": "verb", "zh": "发布", "note": "常用来说新产品上市", "phonetic": "", "en": ""}, {"word": "phone", "pos": "noun", "zh": "手机", "note": "", "phonetic": "", "en": ""}, {"word": "screen", "pos": "noun", "zh": "屏幕", "note": "", "phonetic": "", "en": ""}, {"word": "game", "pos": "noun", "zh": "游戏", "note": "", "phonetic": "", "en": ""}, {"word": "chip", "pos": "noun", "zh": "芯片", "note": "手机的核心零件", "phonetic": "", "en": ""}, {"word": "camera", "pos": "noun", "zh": "摄像头", "note": "", "phonetic": "", "en": ""}, {"word": "battery", "pos": "noun", "zh": "电池", "note": "", "phonetic": "", "en": ""}, {"word": "yuan", "pos": "noun", "zh": "元（人民币）", "note": "中国货币单位", "phonetic": "", "en": ""}], "fetched_at": "2026-10-31T00:58:25.335332", "timeline": [{"i": 0, "w": "The", "s": 0.25, "e": 0.338, "sm": 250, "em": 337, "cs": 0, "ce": 3, "si": 0}, {"i": 1, "w": "phones", "s": 0.338, "e": 0.725, "sm": 337, "em": 724, "cs": 4, "ce": 10, "si": 0}, {"i": 2, "w": "come", "s": 0.725, "e": 0.863, "sm": 725, "em": 862, "cs": 11, "ce": 15, "si": 0}, {"i": 3, "w": "in", "s": 0.863, "