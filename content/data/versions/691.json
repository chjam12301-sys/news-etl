bella.mp3", "duration": 32.0, "size_bytes": 192960, "engine": "kokoro", "word_count": 98, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/70/en_a1_af_bella.json"}, {"voice": "am_michael", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/70/en_a1_am_michael.mp3", "duration": 34.45, "size_bytes": 207648, "engine": "kokoro", "word_count": 98, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/70/en_a1_am_michael.json"}, {"voice": "bf_emma", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/70/en_a1_bf_emma.mp3", "duration": 30.475, "size_bytes": 183744, "engine": "kokoro", "word_count": 98, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/70/en_a1_bf_emma.json"}, {"voice": "bm_george", "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/70/en_a1_bm_george.mp3", "duration": 31.925, "size_bytes": 192528, "engine": "kokoro", "word_count": 98, "has_timeline": true, "timeline_url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/timeline/70/en_a1_bm_george.json"}]}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@dcbf67c/content/data/versions/691.json", "paragraphs": ["About 550,000 people went to the streets. They protested about schools and the cost of living. In Paris, police used tear gas and water cannon.", "Some people lit fires and looted shops. A fire damaged the town hall in Limoges. In Lyon, the tourist office burned down.", "The Prime Minister said 150 police officers were hurt. President Macron said the people who broke things will be punished.", "Students started these protests. They want more teachers and better schools. Elections in France are coming next year."], "paragraphs_zh": ["大约55万人走上街头。他们抗议学校问题和生活成本。在巴黎，警察使用了催泪瓦斯和高压水枪。", "一些人放火并抢劫商店。一场大火损坏了利摩日的市政厅。在里昂，旅游局大楼被烧毁。", "总理说150名警察受伤。马克龙总统说，破坏东西的人将受到惩罚。", "学生发起了这些抗议。他们想要更多老师和更好的学校。法国明年将举行选举。"], "body": "About 550,000 people went to the streets. They protested about schools and the cost of living. In Paris, police used tear gas and water cannon.\n\nSome people lit fires and looted shops. A fire damaged the town hall in Limoges. In Lyon, the tourist office burned down.\n\nThe Prime Minister said 150 police officers were hurt. President Macron said the people who broke things will be punished.\n\nStudents started these protests. They want more teachers and better schools. Elections in France are coming next year.", "body_zh": "大约55万人走上街头。他们抗议学校问题和生活成本。在巴黎，警察使用了催泪瓦斯和高压水枪。\n\n一些人放火并抢劫商店。一场大火损坏了利摩日的市政厅。在里昂，旅游局大楼被烧毁。\n\n总理说150名警察受伤。马克龙总统说，破坏东西的人将受到惩罚。\n\n学生发起了这些抗议。他们想要更多老师和更好的学校。法国明年将举行选举。", "text": "About 550,000 people went to the streets. They protested about schools and the cost of living. In Paris, police used tear gas and water cannon. Some people lit fires and looted shops. A fire damaged the town hall in Limoges. In Lyon, the tourist office burned down. The Prime Minister said 150 police officers were hurt. President Macron said the people who broke things will be punished. Students started these protests. They want more teachers and better schools. Elections in France are coming next year.", "vocab": [{"word": "protest", "pos": "verb", "zh": "抗议", "note": "常与 about 连用，表示抗议某事", "phonetic": "", "en": ""}, {"word": "arrest", "pos": "verb", "zh": "逮捕", "note": "警察抓人常用这个词", "phonetic": "", "en": ""}, {"word": "police", "pos": "noun", "zh": "警察", "note": "常用复数含义", "phonetic": "", "en": ""}, {"word": "fire", "pos": "noun", "zh": "火；火灾", "note": "light a fire 表示点火", "phonetic": "", "en": ""}, {"word": "hurt", "pos": "verb", "zh": "受伤；伤害", "note": "过去式也是 hurt", "phonetic": "", "en": ""}, {"word": "shop", "pos": "noun", "zh": "商店", "note": "复数 shops", "phonetic": "", "en": ""}, {"word": "student", "pos": "noun", "zh": "学生", "note": "复数 students", "phonetic": "", "en": ""}, {"word": "election", "pos": "noun", "zh": "选举", "note": "常与 next year 连用", "phonetic": 