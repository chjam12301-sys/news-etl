6da5dd4295bf?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MTB8fGRhZCUyMGZpbmVkJTIwc29ufGVufDB8MHx8fDE3OTIxOTQ0ODR8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Steven Van Loy on Unsplash", "author": "Steven Van Loy", "credit_url": "https://unsplash.com/@mafalou?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/man-wears-blue-crew-neck-t-shirt-holding-toddler-wears-black-hooded-jacket-near-ocean-under-blue-sky-at-daytime-oUhSla4L_98?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(165, 42%, 62%)", "to": "hsl(203, 46%, 48%)", "label": "WORLD", "seed": "f11dca163925"}}, "published_date": "2026-10-17", "word_count": 97, "reading_minutes": 0.3, "lead": "キプロスのホテルで、2歳の男の子が4階の窓から落ちて亡くなりました。父親が罰金を払うことになりました。", "lead_zh": "在塞浦路斯的酒店，一名2岁男孩从四楼窗户坠落身亡。父亲被判处缴纳罚款。", "preview": "男の子は7月12日に落ちました。ホテルは5つ星です。家族は休みで来ていました。", "preview_zh": "男孩在7月12日坠落。酒店是五星级。一家人是来度假的。", "has_audio": true, "audio": {"id": 676, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/69/ja_n5.mp3", "duration": 19.375, "size_bytes": 115776, "engine": "kokoro", "voice": "jf_alpha", "word_count": 73, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@2388497/content/data/versions/686.json"}, {"content_hash": "e91c780c01ee303b", "version_id": 687, "article_id": 69, "level_code": "ja_n4", "lang": "ja", "level": 2, "level_label": "N4 初級", "title": "2歳の息子がホテルから転落して死亡、父親に罰金", "title_zh": "两岁儿子从酒店坠落身亡，父亲被罚款", "has_translation": true, "topic": "world", "source": "bbc_world", "source_url": "https://www.bbc.co.uk/news/articles/cvj6j1klez88o?at_medium=RSS&at_campaign=rss", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1437943085269-6da5dd4295bf?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MTB8fGRhZCUyMGZpbmVkJTIwc29ufGVufDB8MHx8fDE3OTIxOTQ0ODR8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Steven Van Loy on Unsplash", "author": "Steven Van Loy", "credit_url": "https://unsplash.com/@mafalou?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/man-wears-blue-crew-neck-t-shirt-holding-toddler-wears-black-hooded-jacket-near-ocean-under-blue-sky-at-daytime-oUhSla4L_98?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(165, 42%, 62%)", "to": "hsl(203, 46%, 48%)", "label": "WORLD", "seed": "f11dca163925"}}, "published_date": "2026-10-17", "word_count": 154, "reading_minutes": 0.5, "lead": "キプロスのホテルで、2歳の男の子が4階の窓から転落して亡くなりました。父親は過失で息子を死なせたとして、罰金を言い渡されました。", "lead_zh": "在塞浦路斯的一家酒店，一名两岁男孩从四楼窗户坠落身亡。父亲因过失导致儿子死亡，被处以罚款。", "preview": "2026年7月12日、イギリス・エセックス出身のジョシュア・フォスターさん（37歳）は、家族とキプロスのホテルに着きました。ホリデー初日の夜、彼は息子を窓のそばに置き、外のウォーターパークを見せようとしました。しかし、窓は閉まっていると思っていたのに、実は開いていました。", "preview_zh": "2026年7月12日，来自英国埃塞克斯的乔舒亚·福斯特（37岁）和家人抵达塞浦路斯的一家酒店。度假第一天的晚上，他把儿子放在窗边，想让他看外面的水上乐园。他以为窗户是关着的，但其实开着。", "has_audio": true, "audio": {"id": 677, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/69/ja_n4.mp3", "duration": 27.475, "size_bytes": 168912, "engine": "kokoro", "voice": "jf_alpha", "word_count": 102, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@2388497/content/data/versions/687.json"}, {"content_hash": "44b5968a3f977f40", "version_id": 688, "article_id": 69, "level_code": "ja_n3", "lang": "ja", "level": 3, "level_label": "N3 中級", "title": "キプロスのホテルで2歳児転落死、父親に罰金3000ユーロ", "title_zh": "塞浦路斯酒店两岁男童坠亡，父亲被罚3000欧元", "has_translation": true, "topic": "world", "source": "bbc_world", "source_url": "https://www.bbc.co.uk/news/articles/cvj6j1klez88o?at_medium=RSS&at_campaign=rss", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1437943085269-6da5dd4295bf?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MTB8fGRhZCUyMGZpbmVkJTIwc29ufGVufDB8MHx8fDE3OTIxOTQ0ODR8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Steven Van Loy on Unsplash", "author": "Steven Van Loy", "credit_url": "https://unsplash.com/@mafalou?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/man-wears-blue-crew-neck-t-shirt-holding-toddler-wears-black-hooded-jacket-near-ocean-under-blue-sky-at-daytime-oUhSla4L_98?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(165, 42%, 62%)", "to": "hsl(203, 46%, 48%)", "label": "WORLD", "seed": "f11dca163925"}}, "published_date": "2026-10-17", "word_count": 189, "reading_minutes": 0.6, "lead": "キプロスのホテルで、2歳の男の子が4階の窓から転落して亡くなりました。父親は過失で息子を死なせたとして、裁判所から3000ユーロの罰金を言い渡されました。", "lead_zh": "在塞浦路斯一家酒店，一名两岁男童从四楼窗户坠落身亡。父亲因过失导致儿子死亡，被法院判处3000欧元罚款。", "preview": "この事故は2026年7月12日、キプロスの5つ星ホテルで起きました。家族が休暇のため到着したその日のことでした。父親のジョシュア・フォスターさん（37歳）は、息子にウォーターパークを見せようと、窓辺に息子をのせました。しかし窓が閉まっていると思っていたのに、実は開いていたのです。", "preview_zh": "这起事故发生在2026年7月12日，塞浦路斯的一家五星级酒店。那天正是全家抵达度假的第一天。37岁的父亲乔舒亚·福斯特为了让儿子看水上乐园，把儿子放在窗台上。他以为窗户是关着的，但其实窗户开着。", "has_audio": true, "audio": {"id": 678, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/69/ja_n3.mp3", "duration": 32.8, "size_bytes": 196704, "engine": "kokoro", "voice": "jf_alpha", "word_count": 129, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@2388497/content/data/versions/688.json"}, {"content_hash": "45e907c9229483c5", "version_id": 689, "article_id": 69, "level_code": "ja_n2", "lang": "ja", "level": 4, "level_label": "N2 中高級", "title": "キプロスのホテルで2歳児転落死、父親に罰金3千ユーロ", "title_zh": "两岁儿子在塞浦路斯酒店坠亡，父亲被判罚款三千欧元", "has_translation": true, "topic": "world", "source": "bbc_world", "source_url": "https://www.bbc.co.uk/news/articles/cvj6j1klez88o?at_medium=RSS&at_campaign=rss", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1437943085269-6da5dd4295bf?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MTB8fGRhZCUyMGZpbmVkJTIwc29ufGVufDB8MHx8fDE3OTIxOTQ0ODR8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Steven Van Loy on Unsplash", "author": "Steven Van Loy", "credit_url": "https://unsplash.com/@mafalou?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/man-wears-blue-crew-neck-t-shirt-holding-toddler-wears-black-hooded-jacket-near-ocean-under-blue-sky-at-daytime-oUhSla4L_98?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(165, 42%, 62%)", "to": "hsl(203, 46%, 48%)", "label": "WORLD", "seed": "f11dca163925"}}, "published_date": "2026-10-17", "word_count": 282, "reading_minutes": 0.9, "lead": "キプロスのホテルで2歳の息子が4階の窓から転落して死亡した事件で、父親が過失致死の罪に問われ、罰金3千ユーロの判決を受けた。裁判所は、窓が閉まっていると思った父親の一瞬の誤りが悲劇を招いたと認定した。", "lead_zh": "在塞浦路斯一家酒店，一名两岁男童从四楼窗户坠落身亡，其父亲被控过失致死，被判罚款三千欧元。法院认定，父亲误以为窗户关着，这一瞬间的失误酿成了悲剧。", "preview": "イングランド東部エセックス出身のジョシュア・フォスター被告（37歳）は、2026年7月12日、家族旅行初日にキプロス・クロラカスの5つ星ホテル「キング・エヴェルトン・ビーチ・ホテル・アンド・リゾート」で、2歳の息子を4階の窓枠に座らせた。被告は窓が閉まっていると思い込み、ウォータ", "preview_zh": "来自英格兰东部埃塞克斯的乔舒亚·福斯特（37岁）于2026年7月12日，在塞浦路斯乔拉卡斯的五星级酒店“国王埃维尔顿海滩度假酒店”，把两岁的儿子放在四楼窗台上。他以为窗户是关着的，想让儿子看水上乐园，但没能抓住儿子，男童从约12米高处坠落。", "has_audio": true, "audio": {"id": 669, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/69/ja_n2.mp3", "duration": 48.075, "size_bytes": 288288, "engine": "kokoro", "voice": "jf_alpha", "word_count": 178, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@2388497/content/data/versions/689.json"}, {"content_hash": "54d371d053bf6471", "version_id": 690, "article_id": 69, "level_code": "ja_n1", "lang": "ja", "level": 5, "level_label": "N1 上級", "title": "サイプラスホテルで2歳児転落死、父親に罰金3000ユーロ", "title_zh": "塞浦路斯酒店2岁男童坠亡，父亲被罚3000欧元", "has_translation": true, "topic": "world", "source": "bbc_world", "source_url": "https://www.bbc.co.uk/news/articles/cvj6j1klez88o?at_medium=RSS&at_campaign=rss", "image": {"type": "photo", "url": "https://images.unsplash.com/photo-1437943085269-6da5dd4295bf?ixid=M3wxMDk3Mzk1fDB8MXxzZWFyY2h8MTB8fGRhZCUyMGZpbmVkJTIwc29ufGVufDB8MHx8fDE3OTIxOTQ0ODR8MA&ixlib=rb-4.1.0&w=1600&q=75&fm=jpg&fit=max", "provider": "unsplash", "credit": "Photo by Steven Van Loy on Unsplash", "author": "Steven Van Loy", "credit_url": "https://unsplash.com/@mafalou?utm_source=daily-english-news&utm_medium=referral", "source": "Unsplash", "source_url": "https://unsplash.com/photos/man-wears-blue-crew-neck-t-shirt-holding-toddler-wears-black-hooded-jacket-near-ocean-under-blue-sky-at-daytime-oUhSla4L_98?utm_source=daily-english-news&utm_medium=referral", "fallback": {"type": "gradient", "from": "hsl(165, 42%, 62%)", "to": "hsl(203, 46%, 48%)", "label": "WORLD", "seed": "f11dca163925"}}, "published_date": "2026-10-17", "word_count": 354, "reading_minutes": 1.1, "lead": "サイプラスのホテルで2歳の男児が4階の窓から転落して死亡した事故で、パフォス地方裁判所は父親に対し、罰金3000ユーロ（約2500ポンド）の判決を言い渡した。裁判官は「一瞬の過ち」が致命的な結果を招いたと述べた。", "lead_zh": "在塞浦路斯一家酒店，一名2岁男童从4楼窗户坠落身亡。帕福斯地方法院判处其父亲3000欧元（约2500英镑）罚款。法官称这是“一瞬间的失误”导致了致命后果。", "preview": "イングランド東部エセックス出身のジョシュア・フォスター被告（37）は、7月12日、家族旅行初日に滞在していた五つ星のキング・エヴェルトン・ビーチ・ホテル・アンド・リゾートで、2歳の息子を窓枠に乗せてウォーターパークの眺めを見せようとした際、窓が閉まっていると誤認し、息子を「取り落", "preview_zh": "来自英格兰东部埃塞克斯的乔舒亚·福斯特（37岁）于7月12日，即家庭度假第一天，在下榻的五星级国王埃维尔顿海滩度假酒店，把2岁儿子放在窗台上让他看水上乐园的景色时，误以为窗户是关着的，结果“失手”让儿子掉了下去。男童从约12米高处坠落，被送往帕福斯综合医院，随后被确认死亡。", "has_audio": true, "audio": {"id": 670, "url": "https://pub-aba43a6fb1db4dc08fede1dbc81f3241.r2.dev/audio/69/ja_n1.mp3", "duration": 59.95, "size_bytes": 363024, "engine": "kokoro", "voice": "jf_alpha", "word_count": 231, "has_timeline": true}, "detail_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@2388497/content/data/versions/690.json"}]}}, "dates": ["2026-10-17", "2026-10-16", "2026-10-15", "2026-10-14", "2026-10-13", "2026-10-12", "2026-10-10", "2026-10-09", "2026-10-08", "2026-10-07", "2026-10-06", "2026-10-05"], "base_url": "https://cdn.jsdelivr.net/gh/chjam12301-sys/news-etl@2388497/content", "index_url": "https://cdn.jsdelivr.net/gh/chj